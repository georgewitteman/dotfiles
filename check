#!/bin/sh

set -o errexit

case "${1:-}" in
  -h | --help)
    echo "usage: $(basename "$0")"
    echo
    echo "Runs the tests, then lints this repo's scripts and the installed shell files"
    echo "with shellcheck and shfmt if they're installed. Run it after \`chezmoi apply\`."
    exit
    ;;
esac

cd -- "$(dirname -- "$0")"
repo_dir="$(pwd)"
for test_file in tests/test_*; do
  echo "RUNNING: ${test_file}"
  sh -eux "$test_file"
done

# The scripts that start with a bash or sh shebang, and the startup files for
# bash and sh.
scripts() {
  for file in .scripts/*; do
    case "$(head -1 "$file")" in
      *bash* | */sh* | *env\ sh*) echo "$file" ;;
    esac
  done
}
cd "$HOME"
files="$(scripts)
.shinit
.profile
.bashrc
.bash_profile"
if command -v shellcheck >/dev/null; then
  echo "RUNNING: shellcheck"
  # The installed files are outside this repo, so shellcheck doesn't find its
  # config. Pass its optional checks with --enable, which works in older
  # versions than --rcfile does.
  enable="$(sed -n 's/^enable=//p' "${repo_dir}/.shellcheckrc" | paste -sd , -)"
  echo "$files" | xargs shellcheck -x --enable="$enable"
  (cd "$repo_dir" && shellcheck -x install.sh check tests/*.sh)
fi
if command -v shfmt >/dev/null; then
  echo "RUNNING: shfmt"
  echo "$files" | xargs shfmt --indent 2 --case-indent --diff --simplify
  (cd "$repo_dir" && shfmt --indent 2 --case-indent --diff --simplify install.sh check tests/*.sh)
fi
