#!/bin/sh

set -o errexit

case "${1:-}" in
  -h | --help)
    echo "usage: $(basename "$0")"
    echo
    echo "Runs the tests, then lints the installed shell files with shellcheck and"
    echo "shfmt if they're installed. Run it after \`chezmoi apply\`."
    exit
    ;;
esac

for test_file in tests/test_*; do
  echo "RUNNING: ${test_file}"
  sh -eux "$test_file"
done

cd "$HOME"
if command -v shellcheck >/dev/null 2>&1; then
  echo "RUNNING: shellcheck"
  # -x: follow sourced files, like .profile, which isn't linted on its own when
  # Docker Desktop's block is above its shebang.
  "${HOME}/.scripts/get-files-to-lint" | sed "s#${HOME}/##" | xargs shellcheck -x
fi
if command -v shfmt >/dev/null 2>&1; then
  echo "RUNNING: shfmt"
  "${HOME}/.scripts/get-files-to-lint" | xargs shfmt --indent 2 --case-indent --diff --simplify
fi
