#!/bin/sh

# Stop at the first command that fails.
set -o errexit

# check takes no arguments. -?* matches an option: a - and at least one more
# character.
case "$1" in
  "") ;;
  -h | --help)
    echo "usage: $(basename "$0")"
    echo
    echo "Runs the tests, then lints this repo's scripts and the installed"
    echo "shell files with shellcheck and shfmt if they're installed. Run it"
    echo "after chezmoi apply."
    exit
    ;;
  -?*)
    echo "error: unknown option: ${1}" >&2
    exit 1
    ;;
  *)
    echo "error: unexpected argument: ${1}" >&2
    exit 1
    ;;
esac

# Go to the repo, the directory this script is in. dirname drops the file
# name from $0, the path it was run as, and -- stops a path that starts with
# - from being read as an option.
cd -- "$(dirname -- "$0")"
repo_dir="$(pwd)"
# sh -eux runs each test so it stops at the first failure (-e) or unset
# variable (-u), and prints each command as it runs (-x).
for test_file in tests/test_*; do
  echo "RUNNING: ${test_file}"
  sh -eux "$test_file"
done

# The scripts that start with a bash or sh shebang. head -1 prints a file's
# first line, its shebang.
scripts() {
  for file in .scripts/*; do
    case "$(head -1 "$file")" in
      *bash* | */sh* | *env\ sh*) echo "$file" ;;
    esac
  done
}
# Those scripts, and the startup files for bash and sh.
cd "$HOME"
files="$(scripts)
.shinit
.profile
.bashrc
.bash_profile"
# Lint the installed files and this repo's own scripts in one run each. xargs
# runs the linter with each word of $files as an argument, after the repo's
# scripts, which are given as full paths.
if command -v shellcheck >/dev/null; then
  echo "RUNNING: shellcheck"
  # The installed files are outside this repo, so shellcheck doesn't find its
  # config on its own. -x follows the files they source, and --source-path
  # finds the tests' tests/setup.sh from here.
  echo "$files" | xargs shellcheck -x --rcfile="${repo_dir}/.shellcheckrc" --source-path="$repo_dir" "${repo_dir}/install.sh" "${repo_dir}/check" "$repo_dir"/tests/*.sh
fi
# shfmt checks the formatting: two-space indents, with case branches indented
# (--case-indent), and simpler syntax where it means the same (--simplify).
# --diff prints what it would change instead of changing it.
if command -v shfmt >/dev/null; then
  echo "RUNNING: shfmt"
  echo "$files" | xargs shfmt --indent 2 --case-indent --diff --simplify "${repo_dir}/install.sh" "${repo_dir}/check" "$repo_dir"/tests/*.sh
fi
