#!/usr/bin/env zsh

runs=11

# for arg; do goes through the arguments. -?* matches an option: a - and at
# least one more character. ${0:t} is the script's name without its directory,
# and print -u2 prints to stderr.
shells=()
for arg; do
  case "$arg" in
    -h | --help)
      print "usage: ${0:t} [<shell> ...]"
      print
      print "Times how long each shell takes to start, and prints the median of $runs"
      print "runs. Defaults to whichever of zsh, bash, sh, dash, ksh, fish, tcsh and"
      print "csh are installed."
      print
      print "Prints three columns:"
      print
      print "  login      a login shell in a terminal, like a macOS terminal tab or an"
      print "             ssh session, until it runs its first command"
      print "  non-login  the same without login, like typing the shell's name in a shell"
      print "  -c         running a command with -c, which reads the same files as a"
      print "             script"
      exit
      ;;
    -?*)
      print -u2 "error: unknown option: $arg"
      exit 1
      ;;
    *) shells+=$arg ;;
  esac
done

# zmodload loads zsh's optional modules: datetime for the clock
# ($EPOCHREALTIME, the time in seconds with microseconds), zpty to run a
# shell in a terminal of its own, and zselect to wait for its output.
if ! zmodload zsh/datetime zsh/zpty zsh/zselect; then
  exit 1
fi

# $#shells is how many shells were given.
if (( ! $#shells )); then
  for shell in zsh bash sh dash ksh fish tcsh csh; do
    if command -v "$shell" >/dev/null; then
      shells+=$shell
    fi
  done
fi

# Find each shell before the cd below, so relative paths still work. whence -p
# finds a program in PATH, skipping builtins and functions like false, and
# ${cmd:a} makes the path absolute.
cmds=()
for shell in $shells; do
  if ! cmd="$(whence -p -- "$shell")"; then
    print -u2 "error: $shell not found"
    exit 1
  fi
  cmds+=${cmd:a}
done

# Start the shells in the home directory, the way a terminal does.
cd

# How long the last run took, in whole microseconds, since (n) sorts only whole
# numbers: it reads the digits after a decimal point as a separate number.
# integer makes a variable that drops any fraction it's given.
integer elapsed

# Reads the shell's output until the typed command's output appears. Fails if
# that takes over $1 seconds, or the shell exits first.
wait_for_marker() {
  local deadline=$(( EPOCHREALTIME + $1 )) chunk output=""
  integer left
  until [[ $output == *BENCHMARK* ]]; do
    # zselect -r waits until the terminal has output to read, and fails after
    # its timeout (-t), which is in hundredths of a second.
    (( left = (deadline - EPOCHREALTIME) * 100 ))
    if (( left <= 0 )) || ! zselect -t $left -r $fd; then
      return 1
    fi
    # zpty -r -t reads what output there is without waiting, and returns 2
    # when the shell has exited.
    zpty -r -t bench chunk
    if (( $? == 2 )); then
      return 1
    fi
    output+=$chunk
  done
}

# Starts the shell at $2 in a terminal with $1 as argv[0], where a leading -
# makes it a login shell, the way login and terminals start one. Types a
# command right away, and stops when its output appears.
#
# The typed lines start with a space, which zsh, fish, and bash with
# HISTCONTROL=ignorespace keep out of the history file. Other shells get no
# history file instead. ${1#-} is the name without its -.
#
# zpty bench starts the command in a new terminal named bench, and puts the
# file descriptor to read its output from in REPLY. ${(q)...} quotes a value
# for that command line, and exec -a sets the argv[0] the shell sees.
# zpty -w types a line into the terminal, and zpty -d closes it, which ends
# the shell.
in_terminal() {
  local start=$EPOCHREALTIME fd env="HISTCONTROL=ignorespace"
  if [[ ${1#-} != (zsh|bash|fish) ]]; then
    env+=" HISTFILE=/dev/null"
  fi
  if ! zpty bench "$env exec -a ${(q)1} ${(q)2}"; then
    return 1
  fi
  fd=$REPLY
  # The shell draws the typed line in the output too, so the quotes split the
  # marker there: only the command's output reads BENCHMARK.
  zpty -w bench " echo BENCH''MARK"
  if ! wait_for_marker 10; then
    zpty -d bench
    print -u2 "error: $2 exited or took over 10 seconds to run a command"
    return 1
  fi
  elapsed=$(( (EPOCHREALTIME - start) * 1e6 ))

  # Wait up to a second for it to exit, so it doesn't slow down the next run.
  # The marker won't appear again.
  zpty -w bench " exit"
  wait_for_marker 1
  zpty -d bench
}

with_command() {
  local start=$EPOCHREALTIME
  if ! "$1" -c true </dev/null >/dev/null 2>&1; then
    print -u2 "error: $1 -c true failed"
    return 1
  fi
  elapsed=$(( (EPOCHREALTIME - start) * 1e6 ))
}

# Prints the median time of $runs runs of the command in $@, in milliseconds.
# repeat runs the loop that many times. ${(n)...} sorts the times as numbers,
# and the middle one is at runs / 2 + 1, since zsh counts array entries from
# 1.
median() {
  local -a durations
  repeat $runs; do
    if ! "$@"; then
      return 1
    fi
    durations+=$elapsed
  done
  durations=(${(n)durations})
  printf '%.1f' $(( durations[runs / 2 + 1] / 1000.0 ))
}

# In printf, %-10s pads a value to 10 characters, lined up on the left, and %9s
# to 9, lined up on the right. ${shells:^cmds} takes the two arrays an entry
# at a time from each, so the loop gets each shell's name and path together.
printf '%-10s %9s %9s %9s\n' shell login non-login -c
for shell cmd in ${shells:^cmds}; do
  if ! login="$(median in_terminal "-${shell:t}" "$cmd")" ||
    ! non_login="$(median in_terminal "${shell:t}" "$cmd")" ||
    ! command="$(median with_command "$cmd")"; then
    exit 1
  fi
  printf '%-10s %6s ms %6s ms %6s ms\n' "$shell" "$login" "$non_login" "$command"
done
