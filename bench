#!/usr/bin/env zsh

runs=11

shells=()
for arg; do
  case "$arg" in
    -h | --help)
      print "usage: ${0:t} [<shell> ...]"
      print
      print "Times how long each shell takes to start, and prints the median of $runs"
      print "runs. Defaults to whichever of zsh, bash, sh, dash, ksh, fish, tcsh and"
      print "csh are installed."
      print
      print "  login      a login shell in a terminal, like a macOS terminal tab or an"
      print "             ssh session, until it runs its first command"
      print "  non-login  the same without login, like typing the shell's name in a shell"
      print "  -c         running a command with -c, which reads the same files as a"
      print "             script"
      exit
      ;;
    -?*)
      print -u2 "error: unknown option: $arg"
      exit 1
      ;;
    *) shells+=$arg ;;
  esac
done

zmodload zsh/datetime zsh/zpty zsh/zselect || exit 1

if (( ! $#shells )); then
  for shell in zsh bash sh dash ksh fish tcsh csh; do
    command -v "$shell" >/dev/null && shells+=$shell
  done
fi

# Find each shell before the cd below, so relative paths still work.
cmds=()
for shell in $shells; do
  if ! cmd="$(whence -p -- "$shell")"; then
    print -u2 "error: $shell not found"
    exit 1
  fi
  cmds+=${cmd:a}
done

# Start the shells in the home directory, the way a terminal does.
cd

# How long the last run took, in whole microseconds.
integer elapsed

# Reads the shell's output until the typed command's output appears, for up to
# $1 seconds. Returns 1 if that times out, and 2 if the shell exits first.
wait_for_marker() {
  local deadline=$(( EPOCHREALTIME + $1 )) chunk
  integer left
  until [[ $output == *BENCHMARK* ]]; do
    # zselect's timeout is in hundredths of a second.
    (( left = (deadline - EPOCHREALTIME) * 100 ))
    (( left > 0 )) && zselect -t $left -r $fd || return 1
    zpty -r -t bench chunk
    case $? in
      0) output+=$chunk ;;
      2) return 2 ;;
    esac
  done
}

# Starts the shell at $2 in a terminal with $1 as argv[0], where a leading -
# makes it a login shell, the way login and terminals start one. Types a
# command right away, and stops when its output appears.
#
# The typed lines start with a space, which keeps them out of the history file
# in zsh, fish, and bash with HISTCONTROL=ignorespace.
in_terminal() {
  local start=$EPOCHREALTIME fd output="" error=""
  zpty bench "HISTCONTROL=ignorespace ARGV0=${(q)1} ${(q)2}" || return
  fd=$REPLY
  # The quotes keep the typed command, which line editors redraw, from matching.
  zpty -w bench " echo BENCH''MARK"
  wait_for_marker 10
  case $? in
    1) error="didn't run a command within 10 seconds" ;;
    2) error="exited before running a command" ;;
  esac
  if [[ -n $error ]]; then
    zpty -d bench
    print -u2 "error: $2 $error"
    return 1
  fi
  elapsed=$(( (EPOCHREALTIME - start) * 1e6 ))

  # Let it exit before the next run, so the two don't slow each other down.
  # The marker doesn't appear again, so this waits for the shell to exit, or
  # gives up after a second, since a shell with running jobs won't exit.
  zpty -w bench " exit"
  output=""
  wait_for_marker 1
  zpty -d bench
}

with_command() {
  local start=$EPOCHREALTIME
  if ! "$1" -c true </dev/null >/dev/null 2>&1; then
    print -u2 "error: $1 -c true failed"
    return 1
  fi
  elapsed=$(( (EPOCHREALTIME - start) * 1e6 ))
}

# Prints the median time of $runs runs of the command in $@, in milliseconds.
median() {
  local -a durations
  repeat $runs; do
    "$@" || return
    durations+=$elapsed
  done
  # (n) sorts numerically, but only whole numbers: it reads the digits after a
  # decimal point as a separate number.
  durations=(${(n)durations})
  printf '%.1f' $(( durations[runs / 2 + 1] / 1000.0 ))
}

printf '%-10s %9s %9s %9s\n' shell login non-login -c
for shell cmd in ${shells:^cmds}; do
  login="$(median in_terminal "-${shell:t}" "$cmd")" || exit 1
  non_login="$(median in_terminal "${shell:t}" "$cmd")" || exit 1
  command="$(median with_command "$cmd")" || exit 1
  printf '%-10s %6s ms %6s ms %6s ms\n' "$shell" "$login" "$non_login" "$command"
done
