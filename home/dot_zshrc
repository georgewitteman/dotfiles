#!/usr/bin/env zsh

# .shinit is shared with bash and sh, so run it with sh's rules. Its functions
# keep those rules when they run.
emulate sh -c '. "${HOME}/.shinit"'

# Prompt. It only uses zsh's built-in prompt escapes (no hooks, no commands,
# no prompt_subst), so drawing it costs nothing. See "Prompt Expansion" in
# `man zshmisc`.
#
#   %n@%m in       user@host, only over SSH. Checked once at startup.
#   %~             current directory, with $HOME shown as ~
#   at %D{...}     time the prompt was drawn, e.g. 08:28 PM, which is also
#                  roughly when the previous command finished
#   %(1j.….)       if there's at least 1 background job: "%j job", plus an
#                  "s" when there are 2 or more (%(2j.s.))
#   %(?..…)        if the last command failed: its exit code, white on red
#   newline, then  red # if root (%(!.…)), otherwise $, green if the last
#                  command succeeded and red if it failed (%(?.…))
#
# %B/%b turn bold on/off, %F{color}/%f set/reset the text color, and
# %K{color}/%k set/reset the background color.
if [[ -n $SSH_CONNECTION ]]; then
  PROMPT='%B%F{magenta}%n@%m%f%b in '
else
  PROMPT=''
fi
PROMPT+='%B%F{cyan}%~%f%b at %B%F{yellow}%D{%I:%M %p}%f%b %(1j.%B%F{magenta}%j job%(2j.s.)%f%b .)%(?..%K{red}%B%F{white} %? %f%b%k )
%B%(!.%F{red}#.%(?.%F{green}.%F{red})$)%f%b '

# Completion settings are documented in "Completion System" in
# `man zshcompsys`: https://zsh.sourceforge.io/Doc/Release/Completion-System.html

# Pick from a menu when there are 2 or more matches.
zstyle ':completion:*' menu select=2

# Complete using the text on both sides of the cursor, instead of as if the
# cursor were at the end of the word, then move the cursor to the end.
# https://zsh.sourceforge.io/Doc/Release/Options.html#index-COMPLETEINWORD
setopt complete_in_word always_to_end

# Try each way of matching in turn until one finds something: exactly, then
# ignoring case, then the typed text anywhere in the word.
# https://zsh.sourceforge.io/Guide/zshguide06.html#l170
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'l:|=* r:|=*'

# Colors for files
# - https://zsh.sourceforge.io/Doc/Release/Zsh-Modules.html#The-zsh_002fcomplist-Module
# - Meant to match the default colors of macOS `ls`.
# - Each entry is <type>=<codes>. Types: di directory, ln symlink, so socket,
#   pi pipe, ex executable, bd block device, cd character device, su setuid,
#   sg setgid, tw sticky world-writable directory, ow world-writable
#   directory. Codes are ;-separated ANSI codes: 30-37 set the text color and
#   40-47 the background, each in the order black, red, green, yellow, blue,
#   magenta, cyan, white.
zstyle ':completion:*' list-colors "di=34" "ln=35" "so=32" "pi=33" "ex=31" "bd=34;46" "cd=34;43" "su=30;41" "sg=30;46" "tw=30;42" "ow=30;43"

# Headings in completion lists, in bold. %d is what's being completed, or for
# warnings what was expected.
zstyle ':completion:*' format '%B%d%b'
zstyle ':completion:*:warnings' format 'No matches for: %d'

# Group matches by type, like commands, aliases, and functions, each under its
# own heading.
zstyle ':completion:*' group-name ''

# compinit rebuilds its dump when completion files are added or removed. -u
# uses completion files owned by other users, or writable by them, instead of
# asking, which matters on machines with several users.
# https://zsh.sourceforge.io/Doc/Release/Completion-System.html#Use-of-compinit
autoload -Uz compinit
compinit -u

# Lets zsh use bash completions, like the ones aws and terraform provide.
# https://github.com/zsh-users/zsh/blob/master/Completion/bashcompinit
autoload -U +X bashcompinit
bashcompinit

# https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-completion.html
if ! whence _aws &>/dev/null && command -v aws_completer &>/dev/null; then
  complete -C "$(command -v aws_completer)" aws
fi

if command -v terraform &>/dev/null; then
  # https://github.com/posener/complete/blob/v1/cmd/install/zsh.go
  complete -o nospace -C "$(command -v terraform)" terraform
fi

# Typing a directory's name on its own goes there.
setopt auto_cd

# Allow comments in the interactive shell, like in pasted commands.
setopt interactive_comments

# ^W and Alt-B/Alt-F stop at each / in a path.
WORDCHARS="${WORDCHARS/\//}"

# Use emacs keybindings, since zsh picks vi mode when EDITOR or VISUAL
# contains "vi". See all bindings with `bindkey -L`, and what a key sends by
# pressing ^V and then the key.
bindkey -e

# ^P, ^N, and the up and down arrows go through the history lines that start
# with what's typed so far.
autoload -U up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^P' up-line-or-beginning-search
bindkey '^N' down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search

# Keypad mode (smkx, which Debian's /etc/zsh/zshrc turns on) sends
# ^[OA/^[OB for the arrows instead of ^[[A/^[[B.
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# Space expands an alias before inserting the space.
zle_expand_alias() {
  zle _expand_alias
  zle self-insert
}
zle -N zle_expand_alias
bindkey -M main ' ' zle_expand_alias

# History options are documented in "History" in `man zshoptions`:
# https://zsh.sourceforge.io/Doc/Release/Options.html#History

# Save each command's start time in the history file.
setopt extended_history

# Write each command to the history file as soon as it's entered, so other
# shells started later see it, without mixing other shells' commands into this
# one's history.
setopt inc_append_history

# Keep every run of a command in the history, but skip lines already found
# when going through it with the arrows or ^R.
setopt hist_find_no_dups

# Leave commands that start with a space out of the history. The last one
# stays until the next command, so it can still be edited.
setopt hist_ignore_space

# Keep commands that look like they contain a secret out of the history file.
# Returning 2 keeps them in this shell's history, so the up arrow still works.
# https://zsh.sourceforge.io/Doc/Release/Functions.html#index-zshaddhistory
zshaddhistory() {
  emulate -L zsh
  setopt extended_glob
  local line="${1%$'\n'}"
  # Long pastes, like "Copy as cURL" from browser devtools
  (( ${#line} < 2000 )) || return 2
  # A literal value in a secret-named variable, like FOO_TOKEN=abc,
  # PGPASSWORD="abc", DD_APP_KEY=abc or AWS_ACCESS_KEY_ID=abc, but not
  # TOKEN="$(op read ...)" or TOKEN=$OTHER
  [[ $line == (#i)*(token|secret|passw(or|)d|(api|app|access)[-_]#key)[[:alnum:]_]#=[\"\']#[^\$\"\'[:space:]]* ]] && return 2
  # Secret flags, like --password=abc or --api-key abc
  [[ $line == (#i)*--(password|passwd|token|secret|client-secret|access-token|auth-token|api[-_]#key)[=\ ]* ]] && return 2
  # Auth headers and cookies, like curl -H 'Authorization: ...' or -b 'a=b'
  [[ $line == (#i)*(-H|--header)[=\ ]#[\"\']#(authorization|cookie|[[:alnum:]-]#(token|key|secret)):* ]] && return 2
  [[ $line == *curl*(\ -b|\ --cookie)[=\ ]* ]] && return 2
  # Credentials in a URL, like postgres://user:password@host
  [[ $line == *://[^/@[:space:]]##:[^/@[:space:]]##@* ]] && return 2
  return 0
}

# zsh doesn't save history unless HISTFILE is set. Codespaces keep it in a
# folder that survives rebuilds.
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
if [[ $CODESPACES == "true" && -d /workspaces/.codespaces/.persistedshare ]]; then
  HISTFILE="/workspaces/.codespaces/.persistedshare/.zsh_history"
fi

# How many commands to keep in the history file, and in memory.
SAVEHIST=100000
HISTSIZE=100000
