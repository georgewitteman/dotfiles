#!/bin/sh

# Codespaces clone over HTTPS with their own credentials. git -C runs git in
# the given directory, here the dotfiles repo, and remote get-url prints
# origin's URL.
if [ -z "${CODESPACES-}" ]; then
  url="$(git -C {{ .chezmoi.sourceDir | quote }} remote get-url origin 2>/dev/null || true)"
  case "$url" in
    git@github.com:* | ssh://git@github.com/*) ;;
    *)
      echo "Use ssh repo URL for dotfiles repo:"
      echo '  $ {{ .chezmoi.executable }} git -- remote set-url origin git@github.com:georgewitteman/dotfiles.git'
      echo
      ;;
  esac
fi
# exec replaces the current shell with a new login (-l), interactive (-i) one.
echo
echo "Restart your terminal:"
echo "  $ exec ${SHELL:-/bin/bash} -li"
