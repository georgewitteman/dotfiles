#!/bin/sh

# Load .profile if no parent shell has, like in a non-login shell started by
# `docker exec`. .profile sets ENV, so it's empty here until .profile has run.
if [ -z "$ENV" ]; then
  . "${HOME}/.profile"
fi

# A function instead of the script itself, so it runs in this shell and
# commands like `echo_run cd` affect it. Sourcing a file inside a function
# passes the function's arguments along as $@.
echo_run() { . "${HOME}/.scripts/echo-run"; }

# When Homebrew belongs to another user on this machine, run brew as that user
# with sudo, since only its owner can change it. The owner is the third field
# of ls -ld, which every ls prints the same way, unlike stat's options.
if [ -d "$HOMEBREW_PREFIX" ] && [ ! -w "$HOMEBREW_PREFIX" ] && command -v sudo >/dev/null; then
  # shellcheck disable=SC2012
  brew_owner="$(ls -ld "$HOMEBREW_PREFIX" | awk '{ print $3 }')"
  # shellcheck disable=SC2139
  alias brew="echo-run sudo --set-home --user=${brew_owner} brew"
  unset brew_owner
fi

alias ls='ls --color=auto'
alias la='ls -lah'

# In VS Code's terminal, edit in VS Code. --wait, so tools like git wait for
# the file to be closed.
if [ "${TERM_PROGRAM-}" = vscode ] && command -v code >/dev/null; then
  export EDITOR="code --wait"
fi

alias gs='git status'
alias gb='switch-branch'

alias tf="terraform"

tmp() {
  # shellcheck disable=SC2312
  set -- "${TMPDIR:-$(mktemp -d)}"
  # TMPDIR ends in / on macOS, but not always elsewhere.
  # shellcheck disable=SC2312
  set -- "${1%/}/$(date +%Y-%m-%dT%H%M%S)"
  echo_run mkdir -p "$1"
  echo_run cd "$1"
}

# dotfiles cd has to change this shell's directory, so it's handled here.
dotfiles() {
  if [ "${1-}" = cd ]; then
    echo_run cd "$(chezmoi git -- rev-parse --show-toplevel || true)"
  else
    command dotfiles "$@"
  fi
}

# $EUID is set by bash and zsh, which saves running id.
# shellcheck disable=SC3028
if [ "${EUID:-$(id -u || true)}" -eq 0 ]; then
  PS1='$PWD # '
else
  PS1='$PWD $ '
fi

# Machine-local settings and secrets for interactive shells, kept out of the
# dotfiles repo.
if [ -r "${HOME}/.shinit.local" ]; then
  # shellcheck disable=SC1091
  . "${HOME}/.shinit.local"
fi
