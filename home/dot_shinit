#!/bin/sh

# Load .profile if this shell started without it, like a terminal opened
# before the dotfiles were installed. .profile sets ENV, so it's empty here
# until .profile has run.
if [ -z "$ENV" ]; then
  . "${HOME}/.profile"
fi

# Defined first, so it still works when something below it breaks.
alias resh="restart_shell"
restart_shell() {
  # shellcheck disable=SC2312
  if [ -n "$(jobs)" ]; then
    echo "Current shell has backgrounded jobs. Not restarting."
    return 1
  fi

  # Note: You can't use $0 here since it will be the name of the function, not
  # the shell.
  if [ $# -eq 0 ]; then
    if [ -f "/proc/$$/cmdline" ]; then
      # shellcheck disable=SC2312
      set -- "$(tr '\0' ' ' <"/proc/$$/cmdline" | cut -d ' ' -f 1)"
    else
      # shellcheck disable=SC2312
      set -- "$(ps -p $$ -o comm | tail -1)"
    fi
  fi
  set -- "${1#-}" -li
  echo_run exec "$@"
}

# A function instead of the script itself, so it runs in this shell and
# commands like `echo_run cd` affect it. Sourcing a file inside a function
# passes the function's arguments along as $@.
echo_run() { . "${HOME}/.scripts/echo-run"; }

# When Homebrew belongs to another user on this machine, run brew as that user
# with sudo, since only its owner can change it. stat -f is BSD's (macOS), and
# stat -c is GNU's.
if [ -d "$HOMEBREW_PREFIX" ] && [ ! -w "$HOMEBREW_PREFIX" ] && command -v sudo >/dev/null; then
  brew_owner="$(stat -f %Su "$HOMEBREW_PREFIX" 2>/dev/null || stat -c %U "$HOMEBREW_PREFIX")"
  # shellcheck disable=SC2139
  alias brew="echo-run sudo --set-home --user=${brew_owner} brew"
  unset brew_owner
fi

alias ls='ls --color=auto'
alias la='ls -lah'

# In VS Code's terminal, edit in VS Code. --wait, so tools like git wait for
# the file to be closed.
if [ "${TERM_PROGRAM-}" = vscode ] && command -v code >/dev/null; then
  export EDITOR="code --wait"
fi

alias gs='git status'
alias pull='git pull'
alias gb='switch-branch'

alias tf="terraform"

alias yws="yarn workspace server"

take() {
  # shellcheck disable=SC2164
  mkdir -p "$1" && cd "$1"
}

tmp() {
  # shellcheck disable=SC2312
  set -- "${TMPDIR:-"$(mktemp -d)/"}$(date +%Y-%m-%dT%H%M%S)"
  echo_run mkdir -p "$1"
  echo_run cd "$1"
}

# Unsets credentials and Terraform variables that are set. Leaves AWS_PROFILE
# and AWS_REGION, which aren't secret.
unset_secrets() {
  # shellcheck disable=SC2046,SC2312
  for _secret_var in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN \
    AWS_SECURITY_TOKEN AWS_CREDENTIAL_EXPIRATION AWS_SESSION_EXPIRATION \
    PGPASSWORD TAILSCALE_API_KEY TAILSCALE_OAUTH_CLIENT_SECRET \
    DD_API_KEY DD_APP_KEY \
    $(set | sed -n 's/^\(TF_VAR_[A-Za-z0-9_]*\)=.*/\1/p'); do
    if set | grep -q "^$_secret_var="; then
      echo_run unset "$_secret_var"
    fi
  done
  unset _secret_var

  # zsh keeps commands that look like they hold a secret in this shell's
  # history, though not in the history file. Emptying the history and reading
  # the file back in drops them.
  if [ -n "${ZSH_VERSION-}" ] && [ -r "${HISTFILE-}" ]; then
    _secrets_histsize="$HISTSIZE"
    HISTSIZE=0
    HISTSIZE="$_secrets_histsize"
    unset _secrets_histsize
    echo_run fc -R
  fi
}

# dotfiles cd has to change this shell's directory, so it's handled here.
dotfiles() {
  if [ "${1-}" = cd ]; then
    if command -v deactivate >/dev/null; then
      # When going from some directory where I have a venv activated to the
      # dotfiles directory, I almost never want to actually stay in that
      # virtual environment and have to run `deactivate` manually.
      echo_run deactivate
    fi
    echo_run cd "$(chezmoi git -- rev-parse --show-toplevel || true)"
  else
    command dotfiles "$@"
  fi
}

if ! command -v tailscale >/dev/null; then
  if [ -x "/Applications/Tailscale.app/Contents/MacOS/Tailscale" ]; then
    tailscale() {
      echo_run "/Applications/Tailscale.app/Contents/MacOS/Tailscale" "$@"
    }
  fi
fi

# $EUID is set by bash and zsh, which saves running id.
# shellcheck disable=SC3028
if [ "${EUID:-$(id -u || true)}" -eq 0 ]; then
  PS1='$PWD # '
else
  PS1='$PWD $ '
fi
PS2='> '
PS4='+ '

# Machine-local settings and secrets for interactive shells, kept out of the
# dotfiles repo.
if [ -r "${HOME}/.shinit.local" ]; then
  # shellcheck disable=SC1091
  . "${HOME}/.shinit.local"
fi
