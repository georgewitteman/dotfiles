#!/bin/sh

# Load .profile if no parent shell has, like in a non-login shell started by
# `docker exec`. .profile sets ENV, so it's empty here until .profile has run.
# `.` runs a file in this shell, like bash's source.
if [ -z "$ENV" ]; then
  . "${HOME}/.profile"
fi

# A function instead of the script itself, so it runs in this shell and
# commands like `echo_run cd` affect it. Sourcing a file inside a function
# passes the function's arguments along as $@.
echo_run() { . "${HOME}/.scripts/echo-run"; }

# When Homebrew belongs to another user on this machine, run brew as that user,
# since only its owner can change it. brew as-brew-user is Homebrew's own
# command for that, and uses sudo to switch users.
# -d checks that the prefix is a directory, and -w that this user can write
# to it.
if [ -d "$HOMEBREW_PREFIX" ] && [ ! -w "$HOMEBREW_PREFIX" ]; then
  alias brew='echo-run brew as-brew-user'
fi

# --color=auto colors ls's output only when it goes to a terminal. la lists
# one file per line with details (-l), including hidden files (-a), with
# sizes like 4.0K (-h).
alias ls='ls --color=auto'
alias la='ls -lah'

# In VS Code's terminal, edit in VS Code. --wait, so the command that opened
# the editor waits for the file to be closed.
if [ "$TERM_PROGRAM" = vscode ] && command -v code >/dev/null; then
  export EDITOR="code --wait"
fi

alias gs='git status'
alias gb='switch-branch'

alias tf="terraform"

# Makes a new temporary directory and goes there. mktemp -d creates a private
# directory under TMPDIR, or /tmp when that isn't set.
tmp() {
  # shellcheck disable=SC2312
  echo_run cd "$(mktemp -d)"
}

# dotfiles cd has to change this shell's directory, so it's handled here.
# With anything after cd, like -h, the script handles it instead.
# chezmoi git -- runs git with the rest of the arguments in chezmoi's source
# repo, and rev-parse --show-toplevel prints that repo's top directory.
# command runs the dotfiles script instead of this function.
dotfiles() {
  if [ "$1" = cd ] && [ "$#" -eq 1 ]; then
    echo_run cd "$(chezmoi git -- rev-parse --show-toplevel || true)"
  else
    command dotfiles "$@"
  fi
}

# The prompt is the current directory, then # for root (user ID 0) or $ for
# anyone else. $EUID is the user ID, set by bash and zsh, which saves running
# id -u. The prompt is in single quotes so $PWD is read each time it's drawn.
# shellcheck disable=SC3028
if [ "${EUID:-$(id -u || true)}" -eq 0 ]; then
  PS1='$PWD # '
else
  PS1='$PWD $ '
fi

# Machine-local settings and secrets for interactive shells, kept out of the
# dotfiles repo. -r checks that the file exists and can be read.
if [ -r "${HOME}/.shinit.local" ]; then
  # shellcheck disable=SC1091
  . "${HOME}/.shinit.local"
fi
