#!/bin/sh

case "${1-}" in
  -h | --help)
    echo "usage: $(basename "$0") [<port>]"
    echo
    echo "Serves the current directory on http://127.0.0.1:<port> (default 8000)"
    echo "with python3, and opens it with \$BROWSER if it's set, or open on macOS."
    exit
    ;;
esac

port="${1:-8000}"
url="http://127.0.0.1:${port}"

if ! command -v python3 >/dev/null 2>&1; then
  echo-err "python3 is required"
  exit 1
fi

# Some Linux systems have an unrelated `open` (like xdg-open or openvt).
if [ -n "${BROWSER-}" ]; then
  opener="$BROWSER"
elif [ "$(uname || true)" = "Darwin" ]; then
  opener=open
else
  opener=
fi
# Open after the server is up
if [ -n "$opener" ]; then
  (sleep 1 && "$opener" "$url") &
fi

exec echo-run python3 -m http.server "$port" --bind 127.0.0.1
