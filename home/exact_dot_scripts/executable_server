#!/bin/sh

open=false
port=

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      echo "usage: $(basename "$0") [-o|--open] [<port>]"
      echo
      echo "Serves the current directory on http://127.0.0.1:<port> (default 8000)"
      echo "with python3."
      echo
      echo "    -o, --open   open it in the browser, with \$BROWSER if it's set, or open"
      echo "                 on macOS"
      exit
      ;;
    -o | --open) open=true ;;
    -?*)
      echo "error: unknown option: ${1}" >&2
      exit 1
      ;;
    *)
      if [ -n "$port" ]; then
        echo "error: unexpected argument: ${1}" >&2
        exit 1
      fi
      port="$1"
      ;;
  esac
  shift
done

port="${port:-8000}"
url="http://127.0.0.1:${port}"

if ! command -v python3 >/dev/null; then
  echo "error: python3 is required" >&2
  exit 1
fi

if $open; then
  # Some Linux systems have an unrelated `open` (like xdg-open or openvt).
  if [ -n "${BROWSER-}" ]; then
    opener="$BROWSER"
  elif [ "$(uname || true)" = "Darwin" ]; then
    opener=open
  else
    echo "error: can't open a browser here. Set BROWSER, or open ${url} yourself." >&2
    exit 1
  fi
  # Open after the server is up
  (sleep 1 && "$opener" "$url") &
fi

exec echo-run python3 -m http.server "$port" --bind 127.0.0.1
