#!/bin/sh

set -o errexit

usage() {
  echo "usage: $(basename "$0") [-y|--yes] [--mine|--not-mine] [--remote] [--older-than=<days>]"
  echo
  echo "Deletes local branches, oldest first, showing each one with git-show and"
  echo "asking before deleting it. The main branch and the current branch are"
  echo "never deleted."
  echo
  echo "    -y, --yes             delete without asking"
  echo "    --mine                only branches whose latest commit is mine"
  echo "    --not-mine            only branches whose latest commit isn't mine"
  echo "    --remote              delete my branches on origin instead, always asking"
  echo "    --older-than=<days>   only branches whose latest commit is older than this"
}

die() {
  if [ "$#" -ge 2 ]; then
    echo "error: $2" >&2
  fi
  exit "$1"
}

older_than_days=
yes=false
remote=false
refs="refs/heads"
mine_only=false
others_only=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    -[[:alnum:]][[:alnum:]]*)
      # Joined short args (e.g. -abc)
      _value="-${1##-?}"
      _arg="${1%%"${1##-?}"}"
      ;;
    --[[:alnum:]]*=*)
      # Args with values separated by an '=' character
      _value="${1#--[[:alnum:]]*=}"
      _arg="${1%%="${_value}"}"
      ;;
  esac
  if [ -n "${_arg-}${_value-}" ]; then
    shift
    set -- "$_arg" "$_value" "$@"
  fi
  unset _arg _value
  case "$1" in
    -h | --help)
      usage
      exit
      ;;
    -y | --yes)
      yes=true
      ;;
    --older-than)
      [ "$#" -ge 2 ] || die 1 '--older-than requires a value'
      case "$2" in
        '' | *[!0-9]*) die 1 "--older-than value must be a number of days" ;;
      esac
      older_than_days="$2"
      shift
      ;;
    --mine)
      mine_only=true
      ;;
    --not-mine)
      others_only=true
      ;;
    --remote)
      remote=true
      refs="refs/remotes/origin"
      ;;
    -?*) die 1 "unknown option: ${1}" ;;
    *) die 1 "unexpected argument: ${1}" ;;
  esac
  shift
done

if $mine_only && $others_only; then
  die 1 "--mine and --not-mine can't be used together"
fi
if $remote && $others_only; then
  die 1 "--remote only deletes my branches, so it can't be used with --not-mine"
fi

set --
if $yes && ! $remote; then
  set -- echo-run
else
  set -- safe-run
fi

if $remote; then
  set -- "$@" git push origin --delete
else
  set -- "$@" git branch --delete --force
fi

TAB="	"
current_ts="$(date +%s)"
threshold_ts="$((current_ts - (60 * 60 * 24 * older_than_days)))"
if ! main_branch_name="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null)"; then
  echo "error: origin's default branch isn't known. Run: git remote set-head origin --auto" >&2
  exit 1
fi
main_branch_name="${main_branch_name#origin/}"
user_email="$(git config user.email)"
current_branch="$(git rev-parse --abbrev-ref HEAD)"
readonly current_ts threshold_ts TAB main_branch_name user_email current_branch

git for-each-ref --sort=committerdate "$refs" --format="%(authoremail:trim)${TAB}%(committerdate:unix)${TAB}%(refname)" | while IFS="$TAB" read -r author committerdate refname; do
  branch="${refname#"$refs"/}"

  case "$branch" in
    "$main_branch_name" | "$current_branch" | HEAD)
      continue
      ;;
  esac

  if $remote || $mine_only; then
    case "$author" in
      "$user_email") ;;
      *) continue ;;
    esac
  elif $others_only; then
    case "$author" in
      "$user_email") continue ;;
    esac
  fi

  if [ -z "$older_than_days" ] || [ "$committerdate" -le "$threshold_ts" ]; then
    git-show --quiet "${refs}/${branch}"
    "$@" "$branch" || true
    echo
  fi
done
