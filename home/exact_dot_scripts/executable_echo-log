#!/bin/sh

set -o errexit

log_level="$1"
shift

case "$log_level" in
  INFO) log_color="\033[44m" ;;
  OK) log_color="\033[42m" ;;
  WARN) log_color="\033[43m" ;;
  ERROR) log_color="\033[41m" ;;
  *)
    echo "echo-log: unknown level: ${log_level}" >&2
    exit 1
    ;;
esac

# Warnings and errors go to stderr, so they don't mix into output that's piped
# or captured.
case "$log_level" in
  WARN | ERROR) exec 1>&2 ;;
esac

# Color only on a terminal
if [ -t 1 ] || [ -n "${FORCE_COLOR-}" ]; then
  printf "%b\033[97m %s \033[0m " "$log_color" "$log_level"
else
  printf '%s: ' "$log_level"
fi

echo "$@"
