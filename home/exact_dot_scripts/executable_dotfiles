#!/bin/sh

set -o errexit

usage() {
  cat <<EOF
usage: $(basename "$0") apply [-y|--yes]
       $(basename "$0") update [-y|--yes]
       $(basename "$0") edit [<file>...]
       $(basename "$0") cd

Manages these dotfiles with chezmoi.

    apply    show what would change, then ask before applying (-y doesn't ask)
    update   pull the dotfiles repo, then apply the same way
    edit     edit the source of these files, or open the repo without any
    cd       go to the dotfiles repo (in an interactive shell)
EOF
}

die() {
  echo "error: $1" >&2
  exit 1
}

apply() {
  confirm=safe-run
  case "${1-}" in
    -y | --yes)
      confirm=echo-run
      shift
      ;;
  esac
  if [ "$#" -gt 0 ]; then
    die "unexpected argument: ${1}"
  fi

  if echo-run chezmoi verify; then
    echo "Nothing to apply."
    return
  fi
  if ! echo-run chezmoi diff --no-pager; then
    die "couldn't show the diff. See the error above."
  fi
  "$confirm" chezmoi apply
}

if [ "$#" -eq 0 ]; then
  usage >&2
  exit 1
fi

command="$1"
shift

case "$command" in
  -h | --help) usage ;;
  apply) apply "$@" ;;
  update)
    echo-run chezmoi git -- pull --autostash --rebase
    apply "$@"
    ;;
  edit)
    for arg; do
      case "$arg" in
        -*) die "unknown option: ${arg}" ;;
      esac
    done
    echo-run chezmoi edit "$@"
    ;;
  cd)
    if [ "$#" -gt 0 ]; then
      die "unexpected argument: ${1}"
    fi
    echo-run chezmoi cd
    ;;
  *) die "unknown command: ${command}" ;;
esac
