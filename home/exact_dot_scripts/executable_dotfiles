#!/bin/sh

set -o errexit

usage() {
  cat <<EOF
usage: $(basename "$0") apply [-y|--yes] [<chezmoi apply options>...]
       $(basename "$0") update [-y|--yes] [<chezmoi apply options>...]
       $(basename "$0") save [<save options>...]
       $(basename "$0") cd
       $(basename "$0") <chezmoi command>...

A wrapper around chezmoi.

    apply    show what would change, then ask before applying (-y doesn't ask)
    update   pull the dotfiles repo, then apply the same way
    save     commit changes in the dotfiles repo with save
    cd       go to the dotfiles repo (in an interactive shell)

Anything else goes to chezmoi.
EOF
}

apply() {
  confirm=safe-run
  # Rebuild the arguments in place, without -y and its aliases
  for arg; do
    shift
    case $arg in
      --noconfirm | --yes | -y) confirm=echo-run ;;
      *) set -- "$@" "$arg" ;;
    esac
  done

  if echo-run chezmoi verify "$@"; then
    echo-info "Nothing to apply."
    return
  fi
  if ! echo-run chezmoi diff --no-pager "$@"; then
    echo-err "Couldn't show the diff. See the error above."
    exit 1
  fi
  "$confirm" chezmoi apply "$@"
}

if [ "$#" -eq 0 ]; then
  usage >&2
  exit 1
fi

command="$1"
shift

case "$command" in
  -h | --help) usage ;;
  apply) apply "$@" ;;
  update)
    echo-run chezmoi git -- pull --autostash --rebase
    apply "$@"
    ;;
  save)
    source_path="$(chezmoi source-path)"
    save -C "${source_path}" "$@"
    ;;
  *) echo-run chezmoi "$command" "$@" ;;
esac
