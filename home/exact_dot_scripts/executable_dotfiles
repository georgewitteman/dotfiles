#!/bin/sh

# Stop at the first command that fails.
set -o errexit

usage() {
  cat <<EOF
usage: $(basename "$0") apply [-y|--yes]
       $(basename "$0") update [-y|--yes]
       $(basename "$0") edit [<file>...]
       $(basename "$0") cd

Manages these dotfiles with chezmoi.

    apply    show what would change, then ask before applying (-y doesn't ask)
    update   pull the dotfiles repo, then apply the same way
    edit     edit the source of these files, or open the repo without any
    cd       go to the dotfiles repo (in an interactive shell)
EOF
}

die() {
  echo "error: $1" >&2
  exit 1
}

# Sets confirm from apply's and update's arguments, before anything runs.
parse_apply_args() {
  confirm=safe-run
  case "$1" in
    -h | --help)
      usage
      exit
      ;;
    -y | --yes)
      confirm=echo-run
      shift
      ;;
    # -?* matches an option: a - and at least one more character.
    -?*) die "unknown option: ${1}" ;;
  esac
  if [ "$#" -gt 0 ]; then
    die "unexpected argument: ${1}"
  fi
}

# chezmoi verify succeeds when there's nothing to apply. $confirm is safe-run,
# which asks first, or echo-run, which doesn't.
apply() {
  if echo-run chezmoi verify; then
    echo "Nothing to apply."
    return
  fi
  if ! echo-run chezmoi diff --no-pager; then
    die "couldn't show the diff. See the error above."
  fi
  "$confirm" chezmoi apply
}

if [ "$#" -eq 0 ]; then
  usage >&2
  exit 1
fi

command="$1"
shift

case "$command" in
  -h | --help) usage ;;
  apply)
    parse_apply_args "$@"
    apply
    ;;
  update)
    parse_apply_args "$@"
    # chezmoi git -- passes the rest to git, run in the dotfiles repo.
    # --rebase puts local commits on top of the pulled ones instead of
    # merging, and --autostash sets aside uncommitted changes during the pull
    # and puts them back after.
    echo-run chezmoi git -- pull --autostash --rebase
    apply
    ;;
  edit)
    # for arg; do goes through "$@".
    for arg; do
      case "$arg" in
        -h | --help)
          usage
          exit
          ;;
        -*) die "unknown option: ${arg}" ;;
      esac
    done
    echo-run chezmoi edit "$@"
    ;;
  cd)
    case "$1" in
      -h | --help)
        usage
        exit
        ;;
      -?*) die "unknown option: ${1}" ;;
    esac
    if [ "$#" -gt 0 ]; then
      die "unexpected argument: ${1}"
    fi
    # chezmoi cd starts a new shell in the dotfiles repo.
    echo-run chezmoi cd
    ;;
  *) die "unknown command: ${command}" ;;
esac
