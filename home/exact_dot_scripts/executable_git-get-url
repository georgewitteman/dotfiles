#!/bin/sh

set -o errexit

die() {
  [ "$#" -ge 2 ] && echo "error: $2" >&2
  exit "$1"
}

usage() {
  cat <<EOF
usage: $(basename "$0") [<options>] [<commit> | <file>]

Prints the GitHub URL for the origin remote's repository, or for a commit or a
file in it. A file links to its contents at HEAD, or at --with-commit's commit.

    -c, --commit            link to HEAD's commit
    --with-commit <commit>  link to this commit, or the file at this commit
    --pull-request          search pull requests for the commit
    --branch <branch>       compare this branch with the default branch
EOF
}

# Outside a repo, git ls-remote --get-url just prints the remote's name back,
# so check for a repo first.
git rev-parse --git-dir >/dev/null
pull_request=false
commit=false
commit_id=
branch=
path=

while [ "$#" -gt 0 ]; do
  case "$1" in
    -[[:alnum:]][[:alnum:]]*)
      _value="-${1##-?}"
      _arg="${1%%"${1##-?}"}"
      ;;
  esac
  if [ -n "${_arg-}${_value-}" ]; then
    shift
    set -- "$_arg" "$_value" "$@"
  fi
  unset _arg _value
  case "$1" in
    -h | --help)
      usage
      exit
      ;;
    -c | --commit)
      commit=true
      ;;
    --pull-request)
      commit=true
      pull_request=true
      ;;
    --branch)
      if [ $# -lt 2 ]; then
        die 1 "${1} requires a value"
      fi
      branch="$2"
      shift
      ;;
    --with-commit)
      if [ $# -lt 2 ]; then
        die 1 "${1} requires a value"
      fi
      commit=true
      commit_id="$(git rev-parse --short "$2")"
      shift
      ;;
    --)
      shift
      break
      ;;
    -?*) die 1 "unknown option: ${1}" ;;
    *)
      if git rev-parse --short "$1" >/dev/null 2>&1; then
        commit=true
        commit_id="$(git rev-parse --short "$1")"
      elif [ -f "$1" ]; then
        # The path from the repository's root, from wherever it's given
        path="$(git ls-files --full-name -- "$1")"
        if [ -z "$path" ]; then
          die 1 "not tracked by git: ${1}"
        fi
        commit=true
        if [ -z "$commit_id" ]; then
          commit_id="$(git rev-parse --short HEAD)"
        fi
      else
        die 1 "not a commit or file: ${1}"
      fi
      ;;
  esac
  shift
done

default_remote="origin"
giturl="$(git ls-remote --get-url "$default_remote")"

if [ -z "$giturl" ]; then
  die 1 "Git remote is not set for ${default_remote}"
fi

case "$giturl" in
  https://*)
    project_url="$(echo "$giturl" | sed "s~\.git$~~")"
    ;;
  ssh://*)
    project_url="$(echo "$giturl" | sed "s~^ssh://[^@]*@~https://~" | sed "s~\.git$~~")"
    ;;
  *)
    project_url="$(echo "$giturl" | sed "s~:~/~" | sed "s~git@~https://~" | sed "s~\.git$~~")"
    ;;
esac

if $pull_request; then
  case $project_url in
    *github.com*) ;;
    *)
      die 1 "Can't generate pull request URLs for non-GitHub PRs"
      ;;
  esac
fi

if [ -n "$branch" ]; then
  echo "${project_url}/compare/${branch}"
  exit
fi

if $commit; then
  if [ -z "$commit_id" ]; then
    commit_id="$(git rev-parse --short HEAD)"
  fi
  if $pull_request; then
    echo "${project_url}/pulls?q=${commit_id}"
    exit
  fi
  if [ -z "$path" ]; then
    echo "${project_url}/commit/${commit_id}"
    exit
  fi
  echo "${project_url}/blob/${commit_id}/${path}"
  exit
fi

echo "$project_url"
