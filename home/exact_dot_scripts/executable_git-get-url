#!/bin/sh

set -o errexit

die() {
  echo "error: $2" >&2
  exit "$1"
}

usage() {
  cat <<EOF
usage: $(basename "$0") [--with-commit <commit> | --branch <branch>]

Prints the GitHub URL for the origin remote's repository, one of its commits,
or a comparison of a branch with the default branch.

    --with-commit <commit>  link to this commit
    --branch <branch>       compare this branch with the default branch
EOF
}

commit_id=
branch=

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit
      ;;
    --branch | --with-commit)
      if [ $# -lt 2 ]; then
        die 1 "${1} requires a value"
      fi
      if [ "$1" = --branch ]; then
        branch="$2"
      else
        commit_id="$(git rev-parse --short "$2")"
      fi
      shift
      ;;
    -?*) die 1 "unknown option: ${1}" ;;
    *) die 1 "unexpected argument: ${1}" ;;
  esac
  shift
done

# Outside a repo, git ls-remote --get-url just prints the remote's name back,
# so check for a repo first.
git rev-parse --git-dir >/dev/null

giturl="$(git ls-remote --get-url origin)"

# Turn the remote into the repository's web page, dropping any user name or
# token, like https://user:token@host/owner/repo.git or git@host:owner/repo.git
case "$giturl" in
  https://*)
    project_url="$(echo "$giturl" | sed -e 's~^https://[^/@]*@~https://~' -e 's~\.git$~~')"
    ;;
  ssh://*)
    project_url="$(echo "$giturl" | sed -e 's~^ssh://[^@]*@~https://~' -e 's~\.git$~~')"
    ;;
  *@*:*)
    project_url="$(echo "$giturl" | sed -e 's~^[^@]*@~https://~' -e 's~:~/~2' -e 's~\.git$~~')"
    ;;
  *)
    die 1 "origin isn't on a web host"
    ;;
esac

if [ -n "$branch" ]; then
  echo "${project_url}/compare/${branch}"
elif [ -n "$commit_id" ]; then
  echo "${project_url}/commit/${commit_id}"
else
  echo "$project_url"
fi
