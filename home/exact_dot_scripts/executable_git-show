#!/bin/sh

set -o errexit

case "${1-}" in
  -h | --help)
    echo "usage: $(basename "$0") [<git show options>] [<object>...]"
    echo
    echo "Runs git show with a header listing the commit's tags, branches, GitHub"
    echo "URL, compare URL, and pull requests."
    exit
    ;;
esac

commit_id="$(git show "$@" --quiet --format="%H")"

# Ref names can't contain spaces or glob characters, so splitting on
# whitespace is safe here.
tags=
heads=
# shellcheck disable=SC2312
for ref in $(git show-ref --dereference | grep "^$commit_id " | cut -d' ' -f2); do
  case "$ref" in
    refs/tags/*)
      tag="${ref#refs/tags/}"
      tags="${tags:+$tags, }${tag%'^{}'}"
      ;;
    refs/heads/*) heads="${heads:+$heads, }${ref#refs/heads/}" ;;
    refs/remotes/*) heads="${heads:+$heads, }${ref#refs/remotes/}" ;;
  esac
done

header="======== git show --format=\"…\" $* ========"
footer="$(printf '%s' "$header" | sed 's/./=/g')"

git_url="$(git-get-url --with-commit "$commit_id" 2>/dev/null || true)"

# The compare URL and PRs are for the branch being shown: the current branch
# when no revision is given, or the local or origin branch when it's the only
# revision.
revs="$(git rev-parse --revs-only "$@" 2>/dev/null || true)"
shown_ref=
if [ -z "$revs" ]; then
  shown_ref="$(git rev-parse --symbolic-full-name HEAD 2>/dev/null || true)"
elif [ "$(echo "$revs" | wc -l || true)" -eq 1 ]; then
  shown_ref="$(git rev-parse --revs-only --symbolic-full-name "$@" 2>/dev/null || true)"
fi
branch=
case "$shown_ref" in
  refs/heads/*) branch="${shown_ref#refs/heads/}" ;;
  refs/remotes/origin/*) branch="${shown_ref#refs/remotes/origin/}" ;;
esac

git_compare_url=
pr_urls=
if [ -n "$branch" ]; then
  git_compare_url="$(git-get-url --branch "${branch}" 2>/dev/null || true)"
  # gh fails fast without network access when it isn't logged in.
  if command -v gh >/dev/null 2>&1; then
    pr_urls="$(gh pr list --head "${branch}" --json url --jq '.[].url' 2>/dev/null | paste -s -d , - | sed 's/,/, /g' || true)"
  fi
fi

fmt=
add() {
  fmt="${fmt:+$fmt%Creset%n}$1"
}
add "$header"
add "     Hash: %h"
add "     %C(cyan)Tags:%Creset %C(bold)${tags}%Creset"
add "    %C(red)Heads:%Creset ${heads}"
[ -z "$git_url" ] || add "      %C(yellow)URL:%Creset ${git_url}"
[ -z "$git_compare_url" ] || add "  %C(yellow)Compare:%Creset ${git_compare_url}"
[ -z "$pr_urls" ] || add "       %C(yellow)PR:%Creset ${pr_urls}"
add "   %C(green)Author:%Creset %an <%ae>"
add "%C(green)Committer:%Creset %cn <%ce>"
add "   %C(blue)A Date:%Creset %ad (%ar)"
add "   %C(blue)C Date:%Creset %cd (%cr)"
add "  %C(magenta)Subject:%Creset %C(bold)%s%Creset"
add "$footer"

git --no-pager show --format="$fmt" "$@"
