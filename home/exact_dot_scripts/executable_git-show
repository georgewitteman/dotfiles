#!/bin/sh

# Stop at the first command that fails.
set -o errexit

quiet=false
commit=

# Go through the arguments one at a time: $# is how many are left, and shift
# drops the first. -?* matches an option: a - and at least one more
# character.
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      echo "usage: $(basename "$0") [-q|--quiet] [<commit>]"
      echo
      echo "Runs git show on the commit (HEAD by default) with a header listing its tags,"
      echo "branches, GitHub URL, compare URL, and pull requests."
      echo
      echo "    -q, --quiet   show only the header, without the diff"
      exit
      ;;
    -q | --quiet) quiet=true ;;
    -?*)
      echo "error: unknown option: ${1}" >&2
      exit 1
      ;;
    *)
      if [ -n "$commit" ]; then
        echo "error: unexpected argument: ${1}" >&2
        exit 1
      fi
      commit="$1"
      ;;
  esac
  shift
done

# ${commit:-HEAD} is the commit given, or HEAD. git rev-parse prints the hash
# of <ref>^{commit}, the commit it names, and --verify --quiet makes it fail
# quietly when there's none, like for a typo.
ref="${commit:-HEAD}"
if ! commit_id="$(git rev-parse --verify --quiet "${ref}^{commit}")"; then
  echo "error: not a commit: ${ref}" >&2
  exit 1
fi

# List the tags and branches that point at the commit. git for-each-ref
# --points-at prints the full name of each, like refs/tags/v1, and
# ${tags:+$tags, } adds a comma only after the first. Ref names can't contain
# spaces or glob characters, so splitting on whitespace is safe here.
tags=
heads=
for ref_name in $(git for-each-ref --points-at "$commit_id" --format='%(refname)' refs/tags refs/heads refs/remotes); do
  case "$ref_name" in
    refs/tags/*) tags="${tags:+$tags, }${ref_name#refs/tags/}" ;;
    refs/heads/*) heads="${heads:+$heads, }${ref_name#refs/heads/}" ;;
    refs/remotes/*/HEAD) ;;
    refs/remotes/*) heads="${heads:+$heads, }${ref_name#refs/remotes/}" ;;
  esac
done

if $quiet; then
  set -- --quiet
fi
if [ -n "$commit" ]; then
  set -- "$@" "$commit"
fi

# $* is all the arguments joined with spaces. The footer is the header with
# every character (.) turned into =.
header="======== git show --format=\"...\" $* ========"
footer="$(printf '%s' "$header" | sed 's/./=/g')"

git_url="$(git-get-url --with-commit "$commit_id" 2>/dev/null || true)"

# The compare URL and PRs are for the branch being shown: the current branch,
# or the local or origin branch that was given. git rev-parse
# --symbolic-full-name prints the full name of what was given, like
# refs/heads/main, or nothing for a commit hash.
shown_ref="$(git rev-parse --symbolic-full-name "$ref")"
branch=
case "$shown_ref" in
  refs/heads/*) branch="${shown_ref#refs/heads/}" ;;
  refs/remotes/origin/*) branch="${shown_ref#refs/remotes/origin/}" ;;
esac

git_compare_url=
pr_urls=
if [ -n "$branch" ]; then
  git_compare_url="$(git-get-url --branch "${branch}" 2>/dev/null || true)"
  # gh fails fast without network access when it isn't logged in. --json url
  # asks for each pull request's URL, and --jq joins them with commas.
  if command -v gh >/dev/null; then
    pr_urls="$(gh pr list --head "${branch}" --json url --jq 'map(.url) | join(", ")' 2>/dev/null || true)"
  fi
fi

# Build git show's --format one line at a time. add puts a color reset and a
# newline (%Creset%n) between lines, but not before the first. In the format,
# %C(color) starts a color and %Creset ends it, and the other % codes are
# fields of the commit, like %h for its short hash, %an and %ae for the
# author's name and email, %ad for the author date and %ar for it relative to
# now, %cn, %ce, %cd and %cr for the same about the committer, and %s for the
# subject.
fmt=
add() {
  fmt="${fmt:+$fmt%Creset%n}$1"
}
add "$header"
add "     Hash: %h"
add "     %C(cyan)Tags:%Creset %C(bold)${tags}%Creset"
add "    %C(red)Heads:%Creset ${heads}"
if [ -n "$git_url" ]; then
  add "      %C(yellow)URL:%Creset ${git_url}"
fi
if [ -n "$git_compare_url" ]; then
  add "  %C(yellow)Compare:%Creset ${git_compare_url}"
fi
if [ -n "$pr_urls" ]; then
  add "       %C(yellow)PR:%Creset ${pr_urls}"
fi
add "   %C(green)Author:%Creset %an <%ae>"
add "%C(green)Committer:%Creset %cn <%ce>"
add "   %C(blue)A Date:%Creset %ad (%ar)"
add "   %C(blue)C Date:%Creset %cd (%cr)"
add "  %C(magenta)Subject:%Creset %C(bold)%s%Creset"
add "$footer"

# Page the diff, but not the header alone, which other scripts print after
# running a command. --no-pager prints straight to the terminal.
if $quiet; then
  git --no-pager show --format="$fmt" "$@"
else
  git show --format="$fmt" "$@"
fi
