#!/bin/sh
# squash-branch.sh
#
# Squash all commits on the current branch (since it diverged from BASE)
# into a single commit. The new commit message is built from all the
# original commit messages stacked on top of each other (oldest first).

set -eu

show_help() {
  cat <<EOF
Usage: $(basename "$0") [base-branch]

Squash all commits on the current branch (since it diverged from BASE)
into a single commit. The squashed commit's message is the concatenation
of all the original commit messages, oldest first.

Arguments:
  base-branch      Base branch to squash against (default: origin/main)

Options:
  -h, --help       Show this help message and exit

Examples:
  $(basename "$0")
  $(basename "$0") origin/develop

Notes:
  • Must be run on the feature/topic branch you want to squash.
  • Rewrites history. After running, push with:
        git push --force-with-lease
  • Requires a clean working tree.
EOF
}

# Parse help flag early
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  show_help
  exit 0
fi

# Determine base branch
if [ "$#" -ge 1 ]; then
  BASE_BRANCH=$1
else
  BASE_BRANCH=origin/main
fi

# Ensure we're in a git repo
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "Error: not a git repository." >&2
  exit 1
fi

# Ensure clean working tree
if ! git diff-index --quiet HEAD --; then
  echo "Error: working tree is not clean. Commit or stash your changes first." >&2
  exit 1
fi

# Make sure base exists locally or remotely
if ! git rev-parse --verify "$BASE_BRANCH" >/dev/null 2>&1; then
  echo "Error: base branch '$BASE_BRANCH' not found." >&2
  exit 1
fi

# Find fork point between base and current HEAD
FORK_POINT=$(git merge-base "$BASE_BRANCH" HEAD || true)

if [ -z "$FORK_POINT" ]; then
  echo "Error: could not determine merge-base with '$BASE_BRANCH'." >&2
  exit 1
fi

# Bail out if there's nothing to squash
COMMIT_COUNT=$(git rev-list --count "$FORK_POINT"..HEAD)
if [ "$COMMIT_COUNT" -eq 0 ]; then
  echo "Nothing to squash: HEAD is at the fork point with '$BASE_BRANCH'." >&2
  exit 1
fi
if [ "$COMMIT_COUNT" -eq 1 ]; then
  echo "Only one commit since '$BASE_BRANCH'; nothing to squash." >&2
  exit 1
fi

# Collect all commit messages on this branch, oldest first, separated by
# a blank line. %B is the full message (subject + body); --reverse gives
# us oldest -> newest.
COMMIT_MSG=$(git log --reverse --format='%B%n' "$FORK_POINT"..HEAD)

# Soft reset to fork point: keeps changes staged, rewinds commits
echo-run git reset --soft "$FORK_POINT"

# Create the single squashed commit
echo-run git commit -m "$COMMIT_MSG"

echo "✅ Done."
echo "Squashed $COMMIT_COUNT commits since '$BASE_BRANCH' into one."
echo "If this branch is pushed to a remote, run:"
echo "    git push --force-with-lease"
