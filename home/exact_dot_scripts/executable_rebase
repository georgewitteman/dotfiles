#!/bin/sh

set -o errexit

usage() {
  cat <<EOF
usage: $(basename "$0") [-i|--interactive] [<base>]
       $(basename "$0") --continue | --abort

Fetches, then rebases the current branch onto origin's copy of <base> (the
main branch by default), stashing and restoring uncommitted changes. If the
fetch fails, it rebases onto what was last fetched. A <base>
that isn't a branch on origin is used as given, like origin/foo or a commit.
For anything else, use git rebase.
EOF
}

# After a finished rebase of a branch that's already pushed, a plain push is
# rejected, so say to force-push.
remind_force_push() {
  for dir in rebase-merge rebase-apply; do
    dir="$(git rev-parse --git-path "$dir")"
    if [ -d "$dir" ]; then
      return
    fi
  done
  upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || return 0
  if ! git merge-base --is-ancestor "$upstream" HEAD; then
    echo "This branch has diverged from ${upstream}. Push with: push -f"
  fi
}

interactive=false
case "${1-}" in
  -h | --help)
    usage
    exit
    ;;
  --continue | --abort)
    if [ "$#" -ne 1 ]; then
      usage >&2
      exit 1
    fi
    echo-run git rebase "$1"
    if [ "$1" = --continue ]; then
      remind_force_push
    fi
    exit
    ;;
  -i | --interactive)
    interactive=true
    shift
    ;;
esac

case "${1-}" in
  -*)
    usage >&2
    exit 1
    ;;
esac

if [ "$#" -gt 1 ]; then
  usage >&2
  exit 1
fi

base="${1:-$(get-main-branch)}"

# Offline, like on a plane, rebasing onto what was last fetched still helps
if ! echo-run git fetch --quiet --prune; then
  echo "warning: fetch failed, so rebasing onto what was last fetched" >&2
fi

if git show-ref --verify --quiet "refs/remotes/origin/${base}"; then
  base="origin/${base}"
fi

if $interactive; then
  echo-run git rebase --interactive --autostash "$base"
else
  echo-run git rebase --autostash "$base"
fi
remind_force_push
