#!/bin/sh

case "${1-}" in
  -h | --help)
    echo "usage: $(basename "$0") [<docker system prune options>...]"
    echo
    echo "Frees disk space with docker system prune -a, which removes stopped"
    echo "containers, unused networks, images no container uses, and the build"
    echo "cache. Docker lists what it will remove and asks first."
    exit
    ;;
esac

exec echo-run docker system prune -a "$@"
