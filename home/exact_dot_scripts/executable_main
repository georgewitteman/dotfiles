#!/bin/sh

set -o errexit

die() {
  [ "$#" -ge 2 ] && echo "error: $2" >&2
  exit "$1"
}

usage() {
  cat <<EOF
usage: $(basename "$0") [-p|--pull] [--rebase]

Switches to the main branch, creating it from origin if there's no local one,
and shows its latest commit. In a linked worktree, where the main branch can't
be checked out because another worktree may have it, it uses a
<worktree directory>-main branch that tracks the same upstream instead.

    -p, --pull      pull after switching, pruning deleted remote branches
    --rebase        pull with --rebase (implies --pull)
EOF
}

pull=false
rebase=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    -[[:alnum:]][[:alnum:]]*)
      _value="-${1##-?}"
      _arg="${1%%"${1##-?}"}"
      ;;
  esac
  if [ -n "${_arg-}${_value-}" ]; then
    shift
    set -- "$_arg" "$_value" "$@"
  fi
  unset _arg _value
  case "$1" in
    -h | --help)
      usage
      exit
      ;;
    -p | --pull) pull=true ;;
    --rebase)
      rebase=true
      pull=true
      ;;
    --)
      shift
      break
      ;;
    -?*) die 1 "unknown option: ${1}" ;;
    *) die 1 "unexpected argument: ${1}" ;;
  esac
  shift
done

toplevel="$(git rev-parse --show-toplevel)"

if ! main_branch="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null)"; then
  echo "error: origin's default branch isn't known. Run: git remote set-head origin --auto" >&2
  exit 1
fi
main_branch="${main_branch#origin/}"

if ! git show-ref --quiet --verify "refs/heads/${main_branch}"; then
  echo-run git branch "$main_branch" "origin/${main_branch}"
fi

# A linked worktree has its own git directory, separate from the repository's
# shared one. A submodule's .git is a file too, but its directories match.
git_dir="$(git rev-parse --git-dir)"
git_dir="$(cd "$git_dir" && pwd -P)"
common_dir="$(git rev-parse --git-common-dir)"
common_dir="$(cd "$common_dir" && pwd -P)"
if [ "$git_dir" != "$common_dir" ]; then
  start_point="$(git rev-parse --abbrev-ref --symbolic-full-name "${main_branch}@{upstream}")"

  # The main branch name is the worktree directory name + '-main'.
  main_branch="$(basename "${toplevel}")-${main_branch}"
  # Check if the branch exists, creating it if it doesn't.
  if ! git show-ref --quiet --verify "refs/heads/${main_branch}"; then
    # --track=direct: use the start point itself as the upstream
    echo-run git branch "$main_branch" --track=direct "$start_point"
  fi
fi

current_branch="$(git branch --show-current)"

if [ "$current_branch" != "$main_branch" ]; then
  echo-run git checkout "$main_branch"
fi

set --

if $rebase; then
  set -- "$@" --rebase
fi

if $pull; then
  echo-run git pull --prune "$@"
fi

git-show --quiet
