#!/bin/sh

set -o errexit

die() {
  echo "error: $1" >&2
  exit 1
}

usage() {
  cat <<EOF
usage: $(basename "$0") [-p|--pull] [--rebase]

Switches to the main branch, creating it from origin if there's no local one,
and shows its latest commit.

    -p, --pull      pull after switching, pruning deleted remote branches
    --rebase        pull with --rebase (implies --pull)
EOF
}

pull=false
rebase=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    -[[:alnum:]][[:alnum:]]*)
      _value="-${1##-?}"
      _arg="${1%%"${1##-?}"}"
      ;;
  esac
  if [ -n "${_arg-}${_value-}" ]; then
    shift
    set -- "$_arg" "$_value" "$@"
  fi
  unset _arg _value
  case "$1" in
    -h | --help)
      usage
      exit
      ;;
    -p | --pull) pull=true ;;
    --rebase)
      rebase=true
      pull=true
      ;;
    -?*) die "unknown option: ${1}" ;;
    *) die "unexpected argument: ${1}" ;;
  esac
  shift
done

if ! main_branch="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null)"; then
  echo "error: origin's default branch isn't known. Run: git remote set-head origin --auto" >&2
  exit 1
fi
main_branch="${main_branch#origin/}"

echo-run git checkout "$main_branch"

if $rebase; then
  set -- --rebase
fi

if $pull; then
  echo-run git pull --prune "$@"
fi

git-show --quiet
