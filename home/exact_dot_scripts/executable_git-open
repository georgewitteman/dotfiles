#!/bin/sh

set -o errexit

case "${1-}" in
  -h | --help)
    echo "usage: $(basename "$0") [git-get-url options]"
    echo
    echo "Opens the repository's web page, or the commit, file, or pull request"
    echo "search that git-get-url builds from the options (see git-get-url -h)."
    echo "Uses \$BROWSER if it's set, and open on macOS. Elsewhere it prints the"
    echo "URL."
    exit
    ;;
esac

url="$(git-get-url "$@")"

# Some Linux systems have an unrelated `open` (like xdg-open or openvt).
if [ -n "${BROWSER-}" ]; then
  echo-run "$BROWSER" "$url"
elif [ "$(uname || true)" = "Darwin" ]; then
  echo-run open "$url"
else
  echo "$url"
fi
