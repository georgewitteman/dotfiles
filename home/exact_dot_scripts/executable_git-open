#!/bin/sh

set -o errexit

die() {
  [ "$#" -ge 2 ] && echo-err "$2" >&2
  exit "$1"
}

url="$(git-get-url "$@")"

if [ -z "$url" ]; then
  die 1 "No URL found."
fi

if command -v open >/dev/null 2>&1; then
  echo-run open "$url"
elif [ -n "${BROWSER-}" ]; then
  echo-run "$BROWSER" "$url"
else
  echo "$url"
fi
