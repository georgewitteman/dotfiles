#!/bin/sh

set -o errexit

die() {
  [ "$#" -ge 2 ] && echo-err "$2" >&2
  exit "$1"
}

url="$(git-get-url "$@")"

if [ -z "$url" ]; then
  die 1 "No URL found."
fi

# Some Linux systems have an unrelated `open` (like xdg-open or openvt).
if [ -n "${BROWSER-}" ]; then
  echo-run "$BROWSER" "$url"
elif [ "$(uname || true)" = "Darwin" ]; then
  echo-run open "$url"
else
  echo "$url"
fi
