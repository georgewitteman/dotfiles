#!/bin/sh

T='AbC' # The test text
BGS='40m 41m 42m 43m 44m 45m 46m 47m 100m 101m 102m 103m 104m 105m 106m 107m'

printf '\n%14s' ''
for BG in $BGS; do
  printf '   %-5s' "$BG"
done
echo

for FG in m 1m 30m '1;30m' 31m '1;31m' 32m '1;32m' 33m '1;33m' 34m '1;34m' \
  35m '1;35m' 36m '1;36m' 37m '1;37m' 90m '1;90m' 91m '1;91m' 92m '1;92m' \
  93m '1;93m' 94m '1;94m' 95m '1;95m' 96m '1;96m' 97m '1;97m'; do
  printf ' %5s \033[%s  %s  ' "$FG" "$FG" "$T"
  for BG in $BGS; do
    printf ' \033[%s\033[%s  %s  \033[0m' "$FG" "$BG" "$T"
  done
  echo
done

printf 'Clear formatting: \\033[0m\n\n'
