#!/bin/sh

case "${1-}" in
  -h | --help)
    echo "usage: $(basename "$0") < input"
    echo
    echo "Copies standard input to the clipboard. Uses pbcopy where it"
    echo "exists. Elsewhere it asks the terminal to do it with OSC 52, which VS"
    echo "Code's terminal supports, including in codespaces."
    exit
    ;;
esac

if [ "$#" -gt 0 ]; then
  echo "error: unexpected argument: ${1}" >&2
  exit 1
fi

# exec replaces this script with pbcopy, which reads the same stdin.
if command -v pbcopy >/dev/null; then
  exec pbcopy
fi

# OSC 52: ESC ] 52 ; c ; <base64> BEL, where c means the clipboard. In printf,
# \033 is ESC and \a is BEL. Write to the terminal itself, since stdout may be
# redirected. tr -d '\n' removes the line breaks base64 adds.
data="$(base64 | tr -d '\n')"
printf '\033]52;c;%s\a' "$data" >/dev/tty
