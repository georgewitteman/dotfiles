#!/bin/sh

set -o errexit
set -o nounset

usage() {
  cat <<EOF
usage: $(basename "$0") [--remote=origin] [--theirs | --mine]
       $(basename "$0") -c|--continue [--no-verify]
       $(basename "$0") --abort

Merges the latest main branch from the remote into the current branch. If
yarn.lock is the only conflict, it reruns yarn install and finishes the merge.

    --remote=<remote>   remote to merge from (default: origin)
    --theirs            prefer the main branch's side in conflicts
    --mine              prefer this branch's side in conflicts
    -c, --continue      after resolving conflicts, stage the files that were
                        in conflict and commit the merge
    --no-verify         with --continue, bypass pre-commit and commit-msg hooks
    --abort             abort the merge in progress
EOF
}

remote="origin"
continue_=false
no_verify=false
abort=false
prefer=

while [ "$#" -gt 0 ]; do
  case "$1" in
    -[[:alnum:]][[:alnum:]]*)
      # Joined short args (e.g. -abc)
      _value="-${1##-?}"
      _arg="${1%%"${1##-?}"}"
      ;;
    --[[:alnum:]]*=*)
      # Args with values separated by an '=' character
      _value="${1#--[[:alnum:]]*=}"
      _arg="${1%%="${_value}"}"
      ;;
  esac
  if [ -n "${_arg-}${_value-}" ]; then
    shift
    set -- "$_arg" "$_value" "$@"
  fi
  unset _arg _value
  case "$1" in
    -h | --help)
      usage
      exit
      ;;
    --abort)
      abort=true
      ;;
    -c | --continue)
      continue_=true
      ;;
    --no-verify)
      no_verify=true
      ;;
    --theirs | --mine)
      if [ -n "$prefer" ]; then
        echo "error: use only one of --theirs and --mine" >&2
        exit 1
      fi
      # git calls the current branch's side "ours"
      if [ "$1" = --theirs ]; then
        prefer=theirs
      else
        prefer=ours
      fi
      ;;
    --remote)
      if [ -z "${2-}" ]; then
        echo "error: --remote requires a value" >&2
        exit 1
      fi
      remote="$2"
      shift
      ;;
    --)
      shift
      break
      ;;
    -?*)
      echo "error: unknown option: ${1}" >&2
      exit 1
      ;;
    *)
      echo "error: unexpected argument: ${1}" >&2
      exit 1
      ;;
  esac
  shift
done

if $abort; then
  echo-run git merge --abort
  exit
fi

if $continue_; then
  if ! git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    echo "error: not in an active merge" >&2
    exit 1
  fi
  # Stage only the files that were in conflict, so untracked files and
  # unrelated edits stay out of the merge commit
  toplevel="$(git rev-parse --show-toplevel)"
  cd "$toplevel"
  conflicted="$(git diff --name-only --diff-filter=U)"
  if [ -n "$conflicted" ]; then
    # git diff --check finds leftover conflict markers. It also checks
    # whitespace, so turn those checks off.
    no_ws=-blank-at-eol,-blank-at-eof,-space-before-tab,-indent-with-non-tab,-tab-in-indent,-cr-at-eol
    markers="$(echo "$conflicted" | while IFS= read -r file; do
      git -c core.whitespace="$no_ws" diff --check -- "$file" || true
    done)"
    if [ -n "$markers" ]; then
      echo "error: conflict markers left:" >&2
      echo "$markers" >&2
      exit 1
    fi
    echo "$conflicted" | while IFS= read -r file; do
      echo-run git add -- "$file"
    done
  fi
  if $no_verify; then
    echo-run git commit --no-edit --no-verify
  else
    echo-run git commit --no-edit
  fi
  exit
fi

if ! main_branch="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null)"; then
  echo "error: origin's default branch isn't known. Run: git remote set-head origin --auto" >&2
  exit 1
fi
main_branch="${main_branch#origin/}"

echo-run git fetch "$remote" "$main_branch"

set --
if [ -n "$prefer" ]; then
  set -- "--strategy-option=${prefer}"
fi

merge_status=0
echo-run git merge --no-edit "$@" "${remote}/${main_branch}" || merge_status=$?

if [ "$merge_status" -eq 0 ]; then
  exit 0
fi

# When yarn.lock is the only conflict, regenerate it and finish the merge.
conflicted_files="$(git diff --name-only --diff-filter=U)"
if [ "$conflicted_files" = "yarn.lock" ]; then
  toplevel="$(git rev-parse --show-toplevel)"
  cd "$toplevel"
  echo-run yarn install
  echo-run git add yarn.lock
  echo-run git commit --no-edit
  exit
fi

exit "$merge_status"
