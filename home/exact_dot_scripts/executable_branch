#!/bin/sh

set -o errexit

usage() {
  cat <<EOF
usage: $(basename "$0") [<options>] <branch name> [<base branch>]

Creates a branch from origin's copy of the base branch (the main branch by
default), without tracking it.

    -l, --latest, -p, --pull   fetch the base branch first
    --stash                    take uncommitted changes to the new branch
EOF
}

branch_name=
latest=false
stash=false
base_branch=

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit
      ;;
    -l | --latest | -p | --pull)
      latest=true
      ;;
    --stash)
      stash=true
      ;;
    -?*)
      echo "error: unknown option: ${1}" >&2
      exit 1
      ;;
    *)
      if [ -z "$branch_name" ]; then
        branch_name="$1"
      elif [ -z "$base_branch" ]; then
        base_branch="$1"
      else
        echo "error: unexpected argument: ${1}" >&2
        exit 1
      fi
      ;;
  esac
  shift
done

if [ -z "$branch_name" ]; then
  echo "error: missing branch name" >&2
  exit 1
fi

if [ -z "$base_branch" ]; then
  if ! base_branch="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null)"; then
    echo "error: origin's default branch isn't known. Run: git remote set-head origin --auto" >&2
    exit 1
  fi
  base_branch="${base_branch#origin/}"
fi

if $latest; then
  echo-run git fetch origin "$base_branch"
fi

# Pop only a stash made here. git stash makes none when there's nothing to
# stash, like when the only changes are untracked files, which stay put anyway.
stashed=false
if $stash; then
  stash_before="$(git rev-parse -q --verify refs/stash || true)"
  echo-run git stash
  stash_after="$(git rev-parse -q --verify refs/stash || true)"
  if [ "$stash_before" != "$stash_after" ]; then
    stashed=true
  fi
fi

exit_code=0
echo-run git checkout -b "$branch_name" --no-track "origin/${base_branch}" || exit_code=$?

if $stashed; then
  echo-run git stash pop
fi

exit "$exit_code"
