#!/bin/sh

set -o errexit
set -o nounset

add=false
push=false
no_edit=true
no_verify=false

usage() {
  cat <<EOF
usage: $(basename "$0") [<options>]

Amends the last commit, keeping its message.

    -a, --add         stage all changes first
    -e, --edit        edit the commit message
    -p, --push        push afterwards, with --force-with-lease
    -n, --no-verify   bypass pre-commit and commit-msg hooks
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -[[:alnum:]][[:alnum:]]*)
      # Joined short args (e.g. -abc)
      _value="-${1##-?}"
      _arg="${1%%"${1##-?}"}"
      ;;
  esac
  if [ -n "${_arg-}${_value-}" ]; then
    shift
    set -- "$_arg" "$_value" "$@"
  fi
  unset _arg _value
  case "$1" in
    -h | --help)
      usage
      exit
      ;;
    -a | --add)
      add=true
      ;;
    -p | --push)
      push=true
      ;;
    -e | --edit)
      no_edit=false
      ;;
    -n | --no-verify)
      no_verify=true
      ;;
    *)
      echo "error: unknown option: ${1}" >&2
      exit 1
      ;;
  esac
  shift
done

if $add; then
  echo-run git add --verbose --all
fi

if $no_edit; then
  set -- "$@" --no-edit
fi

if $no_verify; then
  set -- "$@" --no-verify
fi

echo-run git commit --amend "$@"

if $push; then
  push --force
fi
