#!/bin/sh

set -o errexit

branch=

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      echo "usage: $(basename "$0") [<branch>]"
      echo
      echo "Switches branches. With a branch name, it first updates that branch from"
      echo "origin, if origin has it, and sets its upstream. Without one, it lists the"
      echo "most recently committed-to branches to pick from by number."
      exit
      ;;
    --)
      shift
      break
      ;;
    -?*)
      echo "error: unknown option: ${1}" >&2
      exit 1
      ;;
    *)
      if [ -n "$branch" ]; then
        echo "error: unexpected argument: ${1}" >&2
        exit 1
      fi
      branch="$1"
      ;;
  esac
  shift
done

if [ -n "$branch" ]; then
  # Only fetch if the branch exists on the remote
  if git ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
    current_branch="$(git branch --show-current)"
    if [ "$current_branch" = "$branch" ]; then
      echo-run git fetch origin "$branch"
    elif ! echo-run git fetch origin "$branch":"$branch"; then
      # Only a fast-forward updates the branch, so local commits are kept
      echo "warning: ${branch} has commits origin doesn't, so it wasn't updated" >&2
      echo-run git fetch origin "$branch"
    fi
    # Fetching into a local branch does not set its upstream, so set it here.
    # Without this, a plain "git pull" fails on the new branch.
    if ! git rev-parse --abbrev-ref --symbolic-full-name "${branch}@{upstream}" >/dev/null 2>&1; then
      echo-run git branch --set-upstream-to="origin/$branch" "$branch"
    fi
  fi
  echo-run git switch "$branch"
  exit
fi

echo-run git fetch --quiet

# Pick from the most recently committed-to branches by number. The list is
# printed in reverse so number 1, the most recent, sits right above the prompt.
list_branches() {
  git for-each-ref --sort=-committerdate --count=20 refs/heads/ "$@"
}
# Turn off line wrapping while listing so long subjects get cut off at the edge
# of the terminal instead of wrapping.
printf '\033[?7l'
list_branches --color=always --format='%(HEAD) %(color:green)%(refname:short)%(color:reset) - %(color:yellow)%(committerdate:relative)%(color:reset) - %(contents:subject)' |
  nl -w 2 -s ') ' |
  awk '{ lines[NR] = $0 } END { for (i = NR; i > 0; i--) print lines[i] }'
printf '\033[?7h'
printf 'Branch number: '
read -r choice
case "$choice" in
  '' | *[!0-9]*)
    echo "error: not a number: ${choice}" >&2
    exit 1
    ;;
esac
branch="$(list_branches --format='%(refname:short)' | sed -n "${choice}p")"
if [ -z "$branch" ]; then
  echo "error: no branch number ${choice}" >&2
  exit 1
fi
echo-run git switch "$branch"
git-show --quiet
