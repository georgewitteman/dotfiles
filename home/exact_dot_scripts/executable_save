#!/bin/sh

# Stop at the first command that fails.
set -o errexit

USAGE="usage: $(basename "$0") [<options>] [--] [<message>]

Commits the staged changes, with <message> as the commit message (quote it if
it has spaces), or opens an editor without one. With nothing staged, it skips
the commit, unless amending. Use -- before a message that starts with -.

    -a, --add             add all changes
    -p, --push            push branch to remote
    -f, --force           with --push, push with --force-with-lease, which
                          --amend also does
    -n, --no-verify       bypass pre-commit and commit-msg hooks
    --amend               amend previous commit, with the message if one is given"

# The flags hold true or false, which are commands that succeed or fail, so
# if $push runs one of them as the test.
push=false
message=''
force=false
no_verify=false
add=false
amend=false

# Go through the arguments one at a time: $# is how many are left, and shift
# drops the first.
while [ "$#" -gt 0 ]; do
  # Split joined short options, like -ap, into the first one and the rest:
  # -a, then -p. ${1##-?} is what's after the first option (p), so _value is
  # the rest as an option (-p), and ${1%%...} drops it to leave the first
  # (-a). Both go back in front of the remaining arguments, to be handled in
  # turn.
  case "$1" in
    -[[:alnum:]][[:alnum:]]*)
      _value="-${1##-?}"
      _arg="${1%%"${1##-?}"}"
      ;;
  esac
  if [ -n "${_arg-}${_value-}" ]; then
    shift
    set -- "$_arg" "$_value" "$@"
  fi
  unset _arg _value
  case "$1" in
    -h | --help)
      echo "$USAGE"
      exit
      ;;
    -a | --add)
      add=true
      ;;
    -f | --force)
      force=true
      ;;
    -p | --push)
      push=true
      ;;
    --amend)
      amend=true
      ;;
    -n | --no-verify)
      no_verify=true
      ;;
    # -- ends the options, so whatever follows is the message.
    --)
      shift
      break
      ;;
    -*)
      echo "error: unknown option: ${1}" >&2
      exit 1
      ;;
    *)
      if [ -n "$message" ]; then
        echo "error: unexpected argument: ${1}" >&2
        exit 1
      fi
      message="$1"
      ;;
  esac
  shift
done

# The message after --, if any. ${2:-$1} names the extra argument.
if [ $# -gt 0 ]; then
  if [ -n "$message" ] || [ $# -gt 1 ]; then
    echo "error: unexpected argument: ${2:-$1}" >&2
    exit 1
  fi
  message="$1"
fi

if $add; then
  echo-run git add --verbose --all
fi

# git diff --cached compares the staged changes with the last commit, and
# --quiet makes it succeed only when there are none.
staged=true
if git diff --cached --quiet; then
  staged=false
fi

if ! $staged && ! $amend && [ -n "$message" ]; then
  echo "error: nothing is staged, so there's nothing to commit: ${message}" >&2
  exit 1
fi

if $staged || $amend; then
  # A new repository has no commit to go back to yet. git rev-parse --verify
  # --short HEAD prints the current commit's short hash, and fails quietly
  # (--quiet) when there isn't one.
  if current_head="$(git rev-parse --quiet --verify --short HEAD)"; then
    echo "Undo these changes with 'git reset ${current_head}'"
  fi

  # Build git commit's arguments in "$@": set -- empties it, and
  # set -- "$@" ... adds to it.
  set --
  if $no_verify; then
    set -- --no-verify
  fi
  if [ -n "$message" ]; then
    set -- "$@" --message "$message"
  elif $amend; then
    set -- "$@" --no-edit
  fi

  # Ask before amending someone else's commit. git show --no-patch
  # --format='%ae' prints the last commit's author email, without its diff.
  if $amend; then
    current_commit_author="$(git show --no-patch --format='%ae')"
    repo_email="$(git config --get user.email || true)"

    cmd="echo-run"
    if [ "$current_commit_author" != "$repo_email" ]; then
      echo "Are you sure you want to amend a commit that you don't own?"
      echo "Current commit author email: $current_commit_author"
      echo "Your email: $repo_email"
      cmd="safe-run"
    fi
    "$cmd" git commit --amend "$@"
  else
    echo-run git commit "$@"
  fi
else
  echo "Skipping commit since nothing is staged."
fi

# --force-with-lease overwrites the remote branch only if it hasn't changed
# since the last fetch, so it won't drop someone else's commits.
if $push; then
  set --
  if $force || $amend; then
    set -- --force-with-lease
  fi
  echo-run git push "$@"
fi
