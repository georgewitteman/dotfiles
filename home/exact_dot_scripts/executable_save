#!/bin/sh

set -o errexit

USAGE="usage: $(basename "$0") [<options>] [--] [<commit message>...]

    -C PATH               run git from this directory
    -a, --add             add all changes
    -p, --push            push branch to remote
    -f, --force           force updates
    -n, --no-verify       bypass pre-commit and commit-msg hooks
    --amend               amend previous commit, with the message if one is given
"

die() {
  [ "$#" -ge 2 ] && echo "error: $2" >&2
  exit "$1"
}

push=false
message=''
force=false
no_verify=false
add=false
amend=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    -[[:alnum:]][[:alnum:]]*)
      # Joined short args (e.g. -abc)
      _value="-${1##-?}"
      _arg="${1%%"${1##-?}"}"
      ;;
  esac
  if [ -n "${_arg-}${_value-}" ]; then
    shift
    set -- "$_arg" "$_value" "$@"
  fi
  unset _arg _value
  case "$1" in
    -h | --help)
      echo "$USAGE"
      exit
      ;;
    -C)
      cd "$2"
      shift
      ;;
    -a | --add)
      add=true
      ;;
    -f | --force)
      force=true
      ;;
    -p | --push)
      push=true
      ;;
    --amend)
      amend=true
      ;;
    -n | --no-verify)
      no_verify=true
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "error: unknown option: ${1}" >&2
      exit 1
      ;;
    *)
      if [ -n "$message" ]; then
        echo "error: unexpected argument: ${1}" >&2
        exit 1
      fi
      message="$1"
      ;;
  esac
  shift
done

if [ $# -ne 0 ]; then
  if [ -n "$message" ]; then
    echo "error: failed to set commit message: $*" >&2
    echo "error: message already set: ${message}" >&2
    exit 1
  fi
  message="$*"
fi

if $add; then
  echo-run git add --verbose --all
fi

status="$(git status --porcelain)"

if [ -z "$status" ] && [ -n "$message" ]; then
  echo "error: there are no changes so we can't create your commit: ${message}" >&2
  exit 1
fi

if [ -n "$status" ]; then
  current_head="$(git rev-parse --short HEAD)"
  echo "Undo these changes with 'git reset ${current_head}'"

  set --
  if $no_verify; then
    set -- "$@" --no-verify
  fi
  if $amend; then
    current_commit_author="$(git show --no-patch --format='%ae')"
    repo_email="$(git config --get user.email)"

    cmd="echo-run"
    if [ "$current_commit_author" != "$repo_email" ]; then
      echo "Are you sure you want to amend a commit that you don't own?"
      echo "Current commit author email: $current_commit_author"
      echo "Your email: $repo_email"
      cmd="safe-run"
    fi

    if [ -n "$message" ]; then
      set -- "$@" --message "$message"
    else
      set -- "$@" --no-edit
    fi

    "$cmd" git commit --amend "$@" || die $? "Failed to amend commit. Fix any errors and retry"
    unset cmd
  else
    if [ -n "$message" ]; then
      set -- "$@" --message "$message"
    fi

    echo-run git commit "$@" || die $? "Failed to create a commit. Fix any errors and retry."
  fi
else
  echo "Skipping commit since there were no changes."
fi

if $push; then
  set --
  if $force; then
    set -- "$@" --force
  fi

  push "$@"
fi
