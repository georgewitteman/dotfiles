#!/bin/sh

set -o errexit

usage() {
  cat <<EOF
usage: $(basename "$0") <tag>

Deletes a tag on origin and locally, whichever have it. Asks before deleting
it on origin.
EOF
}

case "${1-}" in
  -h | --help)
    usage
    exit
    ;;
  -* | "")
    usage >&2
    exit 1
    ;;
esac

if [ "$#" -ne 1 ]; then
  usage >&2
  exit 1
fi

tag="$1"
on_origin="$(git ls-remote --tags origin "refs/tags/${tag}")"
on_local=false
if git show-ref --verify --quiet "refs/tags/${tag}"; then
  on_local=true
fi

if [ -z "$on_origin" ] && ! $on_local; then
  echo-err "no tag ${tag} on origin or locally"
  exit 1
fi

# Origin first, after asking, so answering no leaves both copies
if [ -n "$on_origin" ]; then
  safe-run git push origin --delete "refs/tags/${tag}"
fi

if $on_local; then
  echo-run git tag -d "$tag"
fi
