#!/bin/sh

set -o errexit

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      echo "usage: $(basename "$0")"
      echo
      echo "cleans up the url that's on the clipboard"
      exit
      ;;
    --)
      shift
      break
      ;;
    -?*)
      echo-err "unknown option: ${1}"
      exit 1
      ;;
    *) break ;;
  esac
  shift
done

# Read the clipboard once, since in VS Code each read may ask for permission.
url="$(clippaste | grep -E -o 'https://linear\.app/[[:alnum:]_]+/issue/[A-Z]+-[0-9]+' | head -n 1 || true)"
if [ -z "$url" ]; then
  echo "not a valid linear url in the clipboard" >&2
  exit 1
fi
echo "$url" >&2
printf '%s' "$url" | clipcopy
