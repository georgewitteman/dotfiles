#!/bin/sh

set -o errexit

usage() {
  cat <<EOF
usage: $(basename "$0") [--edit]
       $(basename "$0") [--edit] -n <name> -e <email>

Changes the author of the last commit, after asking. With no name and email it
makes you the author, using your git config (and sets the author date to now),
like after fixing the repository's user.email or to take over a commit.

    -n, --name <name>     author name
    -e, --email <email>   author email
    --edit                also edit the commit message
EOF
}

new_name=
new_email=
edit=--no-edit

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit
      ;;
    -n | --name | -e | --email)
      if [ "$#" -lt 2 ]; then
        echo "error: ${1} requires a value" >&2
        exit 1
      fi
      case "$1" in
        -n | --name) new_name="$2" ;;
        *) new_email="$2" ;;
      esac
      shift
      ;;
    --edit) edit=--edit ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if [ -n "${new_name}${new_email}" ] && { [ -z "$new_name" ] || [ -z "$new_email" ]; }; then
  echo "error: give both a name and an email, or neither to make you the author" >&2
  exit 1
fi

current="$(git log -1 --format='%an <%ae>')"
echo "Current author: ${current}"

if [ -n "$new_name" ]; then
  safe-run git commit --amend --allow-empty "$edit" --author="${new_name} <${new_email}>"
else
  safe-run git commit --amend --allow-empty "$edit" --reset-author
fi
