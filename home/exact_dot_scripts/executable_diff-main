#!/bin/sh

set -o errexit

case "${1-}" in
  -h | --help)
    echo "usage: $(basename "$0") [<git diff options>] [-- <path>...]"
    echo
    echo "Shows what changed on this branch since it split off from origin's default"
    echo "branch, with git diff --merge-base origin/HEAD."
    exit
    ;;
esac

echo-run git diff --merge-base origin/HEAD "$@"
