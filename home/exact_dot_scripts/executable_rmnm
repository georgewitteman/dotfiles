#!/bin/sh

set -o errexit

dir=
recursive=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      echo "usage: $(basename "$0") [-r] [<directory>]"
      echo
      echo "Deletes <directory>/node_modules (default: the current directory)."
      echo
      echo "    -r, --recursive   delete every node_modules under <directory> instead"
      exit
      ;;
    -r | --recursive)
      recursive=true
      ;;
    -?*)
      echo-err "unknown option: ${1}"
      exit 1
      ;;
    *)
      if [ -n "$dir" ]; then
        echo-err "only one directory allowed, got: ${dir} and ${1}"
        exit 1
      fi
      dir="$1"
      ;;
  esac
  shift
done

if [ -n "$dir" ]; then
  cd "$dir"
fi

if $recursive; then
  dirs="$(find . -name node_modules -type d -prune)"
  if [ -z "$dirs" ]; then
    echo-info "no node_modules under ${PWD}"
    exit
  fi
elif [ -d node_modules ]; then
  dirs=./node_modules
else
  echo-err "no node_modules in ${PWD} (use -r to search subdirectories)"
  exit 1
fi

echo-info "removing:"
while IFS= read -r path; do
  # Show the path relative to where rmnm was run, like the directory argument.
  echo "  ${dir:+${dir%/}/}${path#./}"
  rm -rf "$path"
done <<EOF
$dirs
EOF
