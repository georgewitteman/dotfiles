#!/bin/sh

set -o errexit

case "${1-}" in
  -h | --help)
    echo "usage: $(basename "$0")"
    echo
    echo "Flushes the DNS cache: with dscacheutil and mDNSResponder on macOS, or"
    echo "resolvectl on Linux with systemd-resolved. Uses sudo."
    exit
    ;;
esac

if [ "$(uname || true)" = "Darwin" ]; then
  echo-run sudo dscacheutil -flushcache
  echo-run sudo killall -HUP mDNSResponder
elif command -v resolvectl >/dev/null; then
  echo-run sudo resolvectl flush-caches
else
  echo "error: can't flush the DNS cache here: not macOS, and no resolvectl" >&2
  exit 1
fi
