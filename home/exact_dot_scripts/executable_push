#!/bin/sh

set -o errexit

if [ "$#" -gt 1 ]; then
  echo "error: push only takes -f or --force. Use git push for anything else." >&2
  exit 1
fi

case "${1-}" in
  -h | --help)
    cat <<EOF
usage: $(basename "$0") [-f|--force]

Pushes the current branch, then shows the latest commit. A branch without an
upstream gets one on origin. -f and --force push with --force-with-lease, so
they won't overwrite commits that haven't been fetched. For anything else, use
git push.
EOF
    exit
    ;;
  -f | --force) set -- --force-with-lease ;;
  "") ;;
  *)
    echo "error: push only takes -f or --force. Use git push for anything else." >&2
    exit 1
    ;;
esac

head="$(git rev-parse --abbrev-ref HEAD)"

if [ "$head" = "HEAD" ]; then
  echo "error: not on a branch (detached HEAD)." >&2
  exit 1
fi

if ! git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
  set -- "$@" --set-upstream origin "$head"
fi

echo-run git push "$@"
git-show --quiet
