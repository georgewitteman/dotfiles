#!/bin/sh

set -o errexit

head="$(git rev-parse --abbrev-ref HEAD)"

if [ "$head" = "HEAD" ]; then
  echo-err "You are not on the HEAD of a branch."
  exit 1
fi

if ! git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
  set -- "$@" --set-upstream origin "$head"
fi

# Rebuild the arguments in place, replacing --force with --force-with-lease
for arg in "$@"; do
  shift
  case "$arg" in
    -f | --force) set -- "$@" --force-with-lease ;;
    *) set -- "$@" "$arg" ;;
  esac
done

echo-run git push "$@"
git-show --quiet
