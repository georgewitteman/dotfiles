#compdef merge

_merge() {
  _arguments \
    {-c,--continue}'[stage the files that were in conflict and commit the merge]' \
    '--abort[abort the merge in progress]' \
    '--no-verify[with --continue, bypass pre-commit and commit-msg hooks]' \
    "(--mine)--theirs[prefer the main branch's side in conflicts]" \
    "(--theirs)--mine[prefer this branch's side in conflicts]" \
    '--remote=[remote to merge from (default: origin)]:remote:{compadd -- $(git remote 2>/dev/null)}'
}
