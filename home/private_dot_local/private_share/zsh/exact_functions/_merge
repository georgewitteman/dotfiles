#compdef merge

_merge() {
  _arguments \
    {-c,--continue}'[finish merge]' \
    '--abort[abort a current merge]' \
    '--no-verify[bypass pre-commit and commit-msg hooks]' \
    '(--mine)--theirs[prefer the main branch in conflicts]' \
    "(--theirs)--mine[prefer this branch's side in conflicts]" \
    '--remote=[which remote to merge from (defaults to "origin")]:remote:{compadd -- $(git remote 2>/dev/null)}'
}
