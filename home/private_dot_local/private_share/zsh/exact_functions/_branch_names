#compdef switch-branch branch git-show

# $service is the command being completed, and $PREFIX the word typed so far.
#
# _arguments takes one spec per option or argument. For options,
# {-q,--quiet} is both spellings, (-q --quiet) in front lists the options that
# can't be used with it, and [...] is its description. For arguments,
# N:description:action completes the Nth argument with the action, where
# {...} is code to run, and compadd offers the words given to it as matches.
if [[ $service == git-show ]]; then
  if [[ $PREFIX == -* ]]; then
    _arguments '(-q --quiet)'{-q,--quiet}'[show only the header, without the diff]'
  else
    # git show's own completion: heads, tags, recent commits, and the rest
    _git
  fi
  return
fi

# switch-branch offers local and origin's branches, and branch's base branch
# only origin's, without the origin/ prefix. ${(f)"$(...)"} splits the
# command's output into lines, %(refname:lstrip=3) drops the first three parts
# of refs/remotes/origin/<branch>, and ${origin_branches:#HEAD} removes the
# HEAD entry.
local -a local_branches origin_branches
local_branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
origin_branches=(${(f)"$(git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin 2>/dev/null)"})
origin_branches=(${origin_branches:#HEAD})

case $service in
  # The -- after compadd marks the end of its options, in case a branch name
  # starts with -.
  switch-branch)
    _arguments '1:branch:{compadd -- $local_branches $origin_branches}'
    ;;
  # _guard "^-*" shows "new branch name" while the word doesn't start with -,
  # without offering any matches. compadd -a takes the matches from an array.
  branch)
    _arguments \
      {-l,--latest,-p,--pull}'[fetch the base branch first]' \
      '--stash[take uncommitted changes to the new branch]' \
      '1: :_guard "^-*" "new branch name"' \
      '2:base branch:{compadd -a origin_branches}'
    ;;
esac
