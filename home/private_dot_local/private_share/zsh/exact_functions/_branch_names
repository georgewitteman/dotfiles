#compdef switch-branch squash-branch branch

# switch-branch and branch's base branch take origin's branches without the
# origin/ prefix. squash-branch takes any ref, like origin/main.
local -a local_branches origin_branches refs
local_branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
origin_branches=(${(f)"$(git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin 2>/dev/null)"})
origin_branches=(${origin_branches:#HEAD})
refs=(${${(f)"$(git for-each-ref --format='%(refname)' refs/remotes 2>/dev/null)"}#refs/remotes/})
refs=($local_branches ${refs:#*/HEAD})

case $service in
  switch-branch)
    _arguments '1:branch:{compadd -- ${(u)local_branches} $origin_branches}'
    ;;
  squash-branch)
    _arguments '1:branch:{compadd -a refs}'
    ;;
  branch)
    _arguments \
      {-l,--latest,-p,--pull}'[fetch the base branch first]' \
      '--stash[stash changes and reapply them on the new branch]' \
      '1: :_guard "^-*" "new branch name"' \
      '2:base branch:{compadd -a origin_branches}'
    ;;
esac
