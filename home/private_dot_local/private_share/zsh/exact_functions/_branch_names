#compdef switch-branch branch rebase git-show

# switch-branch, branch's base branch and rebase take origin's branches
# without the origin/ prefix.
local -a local_branches origin_branches
local_branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
origin_branches=(${(f)"$(git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin 2>/dev/null)"})
origin_branches=(${origin_branches:#HEAD})

case $service in
  git-show)
    if [[ $PREFIX == -* ]]; then
      _arguments '(-q --quiet)'{-q,--quiet}'[show only the header, without the diff]'
    else
      # git show's own completion: heads, tags, recent commits, and the rest
      _git
    fi
    ;;
  switch-branch)
    _arguments '1:branch:{compadd -- ${(u)local_branches} $origin_branches}'
    ;;
  rebase)
    _arguments \
      '(--continue --abort)'{-i,--interactive}'[rebase interactively]' \
      '(- 1)--continue[continue the rebase in progress]' \
      '(- 1)--abort[abort the rebase in progress]' \
      '1:base branch:{compadd -- ${(u)local_branches} $origin_branches}'
    ;;
  branch)
    _arguments \
      {-l,--latest,-p,--pull}'[fetch the base branch first]' \
      '--stash[stash changes and reapply them on the new branch]' \
      '1: :_guard "^-*" "new branch name"' \
      '2:base branch:{compadd -a origin_branches}'
    ;;
esac
