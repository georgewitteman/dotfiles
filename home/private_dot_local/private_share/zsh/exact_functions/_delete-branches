#compdef delete-branches

_delete-branches() {
  _arguments \
    {-y,--yes}'[delete without asking]' \
    '(--not-mine)--mine[only branches whose latest commit is mine]' \
    "(--mine --remote)--not-mine[only branches whose latest commit isn't mine]" \
    '(--not-mine)--remote[delete my branches on origin instead, always asking]' \
    '--older-than=[only branches whose latest commit is older than this]:days: '
}
