#compdef dotfiles

_dotfiles() {
  # Offer the files chezmoi manages as ~ paths, so they work from any directory.
  # Other paths complete as plain files.
  if (( CURRENT > 2 )) && [[ ${words[2]} == edit && ${PREFIX} != -* ]]; then
    local -a files
    files=(${(f)"$(chezmoi managed --include=files 2>/dev/null)"})
    if compset -P '\~/'; then
      _multi_parts / files
    elif [[ -z ${PREFIX} ]]; then
      _multi_parts -P '~/' / files
    else
      _files
    fi
    return
  fi

  # The wrapper's own command and options, alongside chezmoi's
  if (( CURRENT == 2 )); then
    local -a commands=('cd:go to the dotfiles repo')
    _describe -t dotfiles-commands 'dotfiles command' commands
  elif [[ ${words[2]} == (apply|update) && ${PREFIX} == -* ]]; then
    local -a options=('-y:apply without asking' '--yes:apply without asking')
    _describe -t dotfiles-options 'dotfiles option' options
  fi

  # dotfiles passes most commands to chezmoi
  _chezmoi "$@"
}
