#compdef save

# _arguments takes one spec per option: {-a,--add} is both spellings, and
# [...] is the description.
_arguments \
  {-a,--add}'[add all changes]' \
  {-p,--push}'[push branch to remote]' \
  {-f,--force}'[with --push, push with --force-with-lease, which --amend also does]' \
  {-n,--no-verify}'[bypass pre-commit and commit-msg hooks]' \
  '--amend[amend the last commit, with the message if given]'
