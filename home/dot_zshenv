#!/usr/bin/env zsh

# Ubuntu's /etc/zsh/zshrc runs compinit unless this is set, and .zshrc runs its
# own.
skip_global_compinit=1

# Skip Terminal.app's per-tab history save/restore in /etc/zshrc_Apple_Terminal;
# it slows every start and exit.
SHELL_SESSIONS_DISABLE=1

# Keep only the first copy of each entry. Nested shells inherit PATH and FPATH
# and add to them again, and a changed fpath makes compinit rebuild its dump.
# The scalars need it too, or assignments like PATH="dir:$PATH" keep duplicates.
typeset -U PATH path FPATH fpath

# Set here instead of .zshrc because some /etc/zsh/zshrc files run compinit
# before .zshrc, like the nvm completion in the devcontainers universal image.
# If those see a different fpath, each compinit rebuilds the dump on every start.
fpath=("${HOME}/.local/share/zsh/functions" "${fpath[@]}")
