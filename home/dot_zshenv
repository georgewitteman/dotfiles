#!/usr/bin/env zsh

# Ubuntu's /etc/zsh/zshrc runs compinit unless this is set, and .zshrc runs its
# own.
skip_global_compinit=1

# Skip Terminal.app's per-tab history save/restore in /etc/zshrc_Apple_Terminal;
# it slows every start and exit.
SHELL_SESSIONS_DISABLE=1

# typeset -U keeps only the first copy of each entry. Nested shells inherit
# PATH and FPATH and add to them again, and duplicate fpath entries change the
# number of completion files compinit counts, which makes it rebuild its dump.
# path and fpath are zsh's array versions of PATH and FPATH, kept in sync with
# them. The scalars need it too, or assignments like PATH="dir:$PATH" keep
# duplicates.
typeset -U PATH path FPATH fpath

# Set here instead of .zshrc because some /etc/zsh/zshrc files run compinit
# before .zshrc. If they see a different fpath, each compinit rebuilds the dump
# on every start. fpath lists the directories zsh loads functions and
# completions from, and "${fpath[@]}" is all of its current entries.
#
# Docker Desktop checks for its zsh completions with a non-interactive login
# shell (zsh -lc), which doesn't read .zshrc. If they aren't there, it prompts
# to add its own block.
fpath=("${HOME}/.local/share/zsh/functions" "${HOME}/.docker/completions" "${fpath[@]}")
