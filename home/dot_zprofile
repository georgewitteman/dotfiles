#!/usr/bin/env zsh

# .profile is shared with bash and sh, so run it with sh's rules. emulate sh -c
# runs the command with zsh's options set to act like sh, just for that
# command.
emulate sh -c '. "${HOME}/.profile"'

# Docker Desktop checks for its zsh completions with a non-interactive login
# shell (zsh -lc), which doesn't read .zshrc. If they aren't there, it prompts to add its own block.
FPATH="${HOME}/.docker/completions:${FPATH}"
