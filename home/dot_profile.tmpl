{{- /* Docker Desktop, with its CLI tools installed for the user, rewrites
       this block at the top of the file every time it starts. Keeping its
       exact text here means it doesn't change anything. */ -}}
{{ if stat (joinPath .chezmoi.homeDir ".docker/bin") -}}
# The following lines were added by Docker Desktop to add commands to your PATH.
export PATH="$PATH:{{ .chezmoi.homeDir }}/.docker/bin"
# End of Docker Desktop section.

{{ end -}}
#!/bin/sh

# Interactive sh shells read the file named in ENV, so they get the same
# aliases and functions as bash and zsh. A set ENV also shows that this file
# has run.
export ENV="${HOME}/.shinit"

# `man environ`: Default editor name.
if [ -z "$EDITOR" ]; then
  if [ -n "$REMOTE_CONTAINERS" ] && command -v code >/dev/null 2>&1; then
    export EDITOR="code"
  else
    export EDITOR="vim"
  fi
fi

# 1Password's app folder exists whenever 1Password is installed, so this holds
# in a shell started before 1Password is running.
if [ -d "${HOME}/Library/Group Containers/2BUA8C4S2C.com.1password" ]; then
  # `man ssh`: SSH_AUTH_SOCK Identifies the path of a UNIX-domain socket used
  # to communicate with the agent.
  export SSH_AUTH_SOCK="${HOME}/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
fi

if [ -x "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv || true)"
fi

# Always add things to PATH so that I can use them directly after installing
# without needing to restart my terminal.
PATH="${HOME}/.local/bin:${PATH}"
PATH="${HOME}/.scripts:${PATH}"
PATH="${HOME}/.cargo/bin:${PATH}"
PATH="/opt/homebrew/opt/libpq/bin:${PATH}"

# Docker Desktop checks for its zsh completions with a login shell, which
# doesn't read .zshrc. If they aren't there, it prompts to add its own block.
if [ -n "$ZSH_VERSION" ]; then
  FPATH="${HOME}/.docker/completions:${FPATH}"
fi
