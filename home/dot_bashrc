#!/usr/bin/env bash

# Interactive shells only. bash also reads this for some non-interactive
# shells, like commands run over ssh.
case $- in *i*) ;; *) return ;; esac

# shellcheck source=.shinit
source "${HOME}/.shinit"

# https://docs.brew.sh/Shell-Completion
# Some of these need bash 4 or later, and macOS comes with bash 3.2.
if ((BASH_VERSINFO[0] >= 4)); then
  if [[ -r "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh" ]]; then
    # shellcheck source=/dev/null
    source "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"
  elif [[ -d "${HOMEBREW_PREFIX}/etc/bash_completion.d" ]]; then
    for COMPLETION in "${HOMEBREW_PREFIX}/etc/bash_completion.d/"*; do
      if [[ -r ${COMPLETION} ]]; then
        # shellcheck source=/dev/null
        source "${COMPLETION}"
      fi
    done
    unset COMPLETION
  fi
fi

# Homebrew's completions above include gh's when gh is installed with Homebrew.
if ! complete -p gh &>/dev/null && command -v gh &>/dev/null; then
  eval "$(gh completion --shell bash || true)"
fi

# https://github.com/posener/complete/blob/v1/cmd/install/bash.go
# https://github.com/posener/complete/blob/9a4745ac49b29530e07dc2581745a218b646b7a3/cmd/install/install.go#L86-L89
if command -v "terraform" &>/dev/null; then
  # shellcheck disable=SC2312
  complete -C "$(command -v terraform)" terraform
fi

# https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-completion.html
if command -v "aws_completer" &>/dev/null; then
  # shellcheck disable=SC2312
  complete -C "$(command -v aws_completer)" aws
fi

# Prompt. It only uses bash's built-in prompt escapes, so drawing it costs
# nothing. See PROMPTING in `man bash`.
#
#   \u@\h in   user@host, only over SSH. Checked once at startup.
#   \w         current directory, with $HOME shown as ~
#   at \@      time the prompt was drawn, e.g. 08:28 PM, which is also
#              roughly when the previous command finished
#   newline, then \$, which is # as root and $ otherwise
#
# \e[1;35m and friends are ANSI colors: 1 is bold, 35 magenta, 36 cyan, 33
# yellow, and 0 resets. Each is wrapped in \[ \] so bash knows it takes up no
# space on screen; otherwise line editing gets confused about the cursor.
#
# Bash has no escape that shows something only sometimes, so showing the exit
# status only after a failure, or the job count only when there are jobs,
# would need a PROMPT_COMMAND function. That isn't worth the extra code.
if [[ -n ${SSH_CONNECTION} ]]; then
  PS1='\[\e[1;35m\]\u@\h\[\e[0m\] in '
else
  PS1=''
fi
PS1+='\[\e[1;36m\]\w\[\e[0m\] at \[\e[1;33m\]\@\[\e[0m\]
\[\e[1m\]\$\[\e[0m\] '
