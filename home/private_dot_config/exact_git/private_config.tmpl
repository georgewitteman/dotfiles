# vim: ft=gitconfig
[user]
	# NOTE: user.email is not configured to force configuration
	# of each repository.
	name = {{ .name | quote }}
	# Instruct Git to avoid trying to guess defaults for
	# user.email and user.name, and instead retrieve the values
	# only from the configuration.
	useConfigOnly = true
[init]
	defaultBranch = main
[pull]
	ff = "only"
# https://blog.gitbutler.com/how-git-core-devs-configure-git/
[diff]
	# Better diffing algorithm
	algorithm = histogram
	# Shows moved text in a different color
	colorMoved = plain
	# diff.mnemonicPrefix will replace the a/ and b/ in your diff
	# header output with where the diff is coming from, so i/
	# (index), w/ (working directory) or c/ commit
	mnemonicPrefix = true
	# Detects if a file has been renamed
	renames = true
[merge]
	# https://blog.nilbus.com/take-the-pain-out-of-git-conflict-resolution-use-diff3/
	# https://stackoverflow.com/q/27417656
	conflictStyle = diff3
[alias]
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)%an%Creset' --abbrev-commit

# NOTE: To resign use either (https://superuser.com/a/1123928)
# - git commit --amend --no-edit -n -S
# - git rebase --exec 'git commit --amend --no-edit -n -S' -i main

{{- /* Sign with my SSH key when it's in the agent (1Password). Skipped in
       codespaces: the key is never there, and while a codespace is being
       created its forwarded agent can hang ssh-add for minutes. */}}
{{- $ssh_sign := false }}
{{- if not (env "CODESPACES") }}
{{- /* `|| true` because output fails the template if ssh-add fails */}}
{{-   $ssh_sign = contains .sshkey (output "sh" "-c" "ssh-add -L 2>/dev/null || true") }}
{{- end }}

{{- if $ssh_sign }}
[user]
	signingKey = {{ .sshkey | quote }}
[gpg]
	format = ssh
{{- end }}

{{- /* Codespaces sign with their own gpg.program in /etc/gitconfig. Anywhere
       else without the key, signing would make every commit fail. */}}
{{- if or $ssh_sign (env "CODESPACES") }}

[commit]
	gpgSign = true
{{- end }}

{{- /* VS Code dev containers set this with `git config --global`, which
       writes to this file when there's no ~/.gitconfig. Keep it so applying
       doesn't remove it. */}}
{{- $credential_helper := output "git" "config" "--default" "" "--global" "credential.helper" | trim }}
{{- if (not (empty $credential_helper)) }}
[credential]
	helper = {{ $credential_helper | quote }}
{{- end }}
