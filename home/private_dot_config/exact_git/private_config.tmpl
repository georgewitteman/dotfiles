[user]
	name = {{ .name | quote }}
	# There's no user.email here, so each repository sets its own. This makes
	# git refuse to commit without one, instead of guessing it from the
	# username and hostname.
	useConfigOnly = true
[init]
	defaultBranch = main
[pull]
	# Fail instead of making a merge commit when the branch has diverged
	ff = only
[push]
	# On a new branch's first push, create it on the remote and track it
	autoSetupRemote = true
[diff]
	# Usually matches up changed lines more readably than the default algorithm
	algorithm = histogram
	# Color moved lines differently from added and removed ones
	colorMoved = plain
	# Label the two sides by where they come from, like i/ (index), w/
	# (working tree) and c/ (commit), instead of a/ and b/
	mnemonicPrefix = true
[merge]
	# Conflicts also show the common ancestor's version, between the two sides,
	# which shows what each side changed
	conflictStyle = diff3

{{- /* Sign with my SSH key. With 1Password installed, through its
       op-ssh-sign, which finds 1Password's agent without SSH_AUTH_SOCK, so
       it works even if 1Password isn't running when applying. Elsewhere, only
       when the key is in the agent, like one forwarded over ssh. Skipped in
       codespaces: the key is never there, and while a codespace is being
       created its forwarded agent can hang ssh-add for minutes.

       In these template lines, {{- drops the whitespace before them, so they
       leave no blank lines. stat is empty when a path doesn't exist, output
       runs a command and returns what it prints, and lookPath finds a program
       in PATH. ssh-add -L prints the public keys the agent holds, and
       git config --default "" prints nothing, instead of failing, when the
       setting isn't there. */}}
{{- $op_ssh_sign := "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" }}
{{- $has_op_ssh_sign := stat $op_ssh_sign }}
{{- $ssh_sign := false }}
{{- if $has_op_ssh_sign }}
{{-   $ssh_sign = true }}
{{- else if not (env "CODESPACES") }}
{{- /* `|| true` because output fails the template if ssh-add fails */}}
{{-   $ssh_sign = contains .sshkey (output "sh" "-c" "ssh-add -L 2>/dev/null || true") }}
{{- end }}

{{- if $ssh_sign }}
[user]
	signingKey = {{ .sshkey | quote }}
[gpg]
	format = ssh
{{- if $has_op_ssh_sign }}
[gpg "ssh"]
	program = {{ $op_ssh_sign | quote }}
{{- end }}
{{- end }}

{{- /* Codespaces sign with their own gpg.program, which they set in
       /etc/gitconfig only when GPG verification is on. Without a signer,
       signing would make every commit fail. */}}
{{- if or $ssh_sign (and (env "CODESPACES") (output "git" "config" "--system" "--default" "" "gpg.program" | trim)) }}

[commit]
	gpgSign = true
{{- end }}

{{- /* VS Code dev containers set this with `git config --global`, which
       writes to this file when there's no ~/.gitconfig. Keep it so applying
       doesn't remove it. */}}
{{- $credential_helper := "" }}
{{- if lookPath "git" }}
{{-   $credential_helper = output "git" "config" "--default" "" "--global" "credential.helper" | trim }}
{{- end }}
{{- if $credential_helper }}
[credential]
	helper = {{ $credential_helper | quote }}
{{- end }}
