" This file has non-ASCII characters, like ↪ and », so Vim needs to know it's
" UTF-8 to read them right.
scriptencoding utf-8

" Vim's recommended defaults, like syntax highlighting and filetype detection
" (`:help defaults.vim`). defaults.vim does nothing when skip_defaults_vim is
" set, so unlet! removes it first (the ! skips the error when it isn't set).
unlet! skip_defaults_vim
source $VIMRUNTIME/defaults.vim

" Optional packages that ship with newer versions of Vim:
" - comment: `gc` to toggle comments
" - nohlsearch: clear search highlighting when the cursor rests for a moment
"   or Insert mode starts
" packadd! loads a package, and silent! hides the error in older Vims that
" don't have it.
silent! packadd! comment
silent! packadd! nohlsearch

" How many columns of whitespace a level of indentation is worth (>, <, ...).
set shiftwidth=2
" How many columns of whitespace a keypress is worth (<Tab>). If negative, use
" the value of shiftwidth
set softtabstop=-1
" Always use spaces instead of tabs
set expandtab
" Copy indent from current line when starting a newline
set autoindent

" When a file has been detected to have been changed outside of Vim and it has
" not been changed inside of Vim, automatically read it again
set autoread

" Ignore case in search patterns. Also used when searching in the tags file
set ignorecase
" Overrides the 'ignorecase' option if the search pattern contains upper case
" characters
set smartcase

" When there is a previous search pattern, highlight all its matches.
set hlsearch

" Every wrapped line will continue visually indented (same amount of space as
" the beginning of that line), thus preserving horizontal blocks of text
set breakindent
" sbr: Display the 'showbreak' value before applying the additional indent
set breakindentopt=sbr
" String to put at the start of lines that have been wrapped. Quoted, so the
" trailing space survives stripping whitespace on save.
let &showbreak = '↪ '
" If on, Vim will wrap long lines at a character in 'breakat' rather than at
" the last character that fits on the screen
set linebreak

" Turn on line numbers
set number
" Change the displayed number to be relative to the cursor. When this option
" and the 'number' option are on, the current line has the real number
set relativenumber

" Show tabs as »· and trailing spaces as ·
set list
set listchars=tab:»·,trail:·

" In the command line, the first Tab completes the longest common part and shows
" the matches in a menu, and each further Tab picks the next match.
set wildmode=longest:full,full

" Enable mouse support for all modes
set mouse=a

" Reselect visual block after indent/outdent. xnoremap maps a key in Visual
" mode, and gv selects the last selection again.
xnoremap < <gv
xnoremap > >gv

" Split below and to the right
set splitbelow
set splitright

" Wait at most 50 ms for the rest of a key code, so Esc is quick
set ttimeoutlen=50

" Always show the status line, not only when the window is split
set laststatus=2

" Use ripgrep for :grep when it's installed. rg --vimgrep prints each match as
" file:line:column:text, which grepformat reads with %f, %l, %c and %m. The \
" keeps the space in the option's value.
if executable('rg')
  set grepprg=rg\ --vimgrep
  set grepformat=%f:%l:%c:%m
endif

" - opens the current file's directory in netrw, with the cursor on the file.
" In netrw, - goes up another level.
"
" expand('%:t') is the current file's name without its directory, and
" :Explore opens netrw on that directory. nnoremap maps - in Normal mode,
" <SID> calls this script's s: function, and <silent> keeps the command off
" the command line.
function! s:OpenDirectory() abort
  let file = expand('%:t')
  Explore
  " netrw may mark executables with * and symlinks with @. In the pattern, ^
  " and \$ are the start and end of the line, \V matches the name literally,
  " and \[*@]\= is an optional * or @.
  call search('^\V' . escape(file, '\') . '\[*@]\=\$')
endfunction
nnoremap <silent> - :call <SID>OpenDirectory()<CR>

" Strip trailing whitespace and blank lines at the end of the file on save,
" without asking, and without highlighting it while editing. These configure
" the vim-better-whitespace plugin.
let g:better_whitespace_enabled = 0
let g:strip_whitespace_on_save = 1
let g:strip_whitespace_confirm = 0
let g:strip_whitelines_at_eof = 1
